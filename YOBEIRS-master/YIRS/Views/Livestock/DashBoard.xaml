<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="YIRS.Views.Livestock.DashBoard"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F7FA">

    <Grid>
        <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
        <ScrollView VerticalOptions="FillAndExpand">
            <StackLayout Spacing="0" Padding="0">

                <!-- Header -->
                <yummy:PancakeView x:Name="HeaderCard"
                                   CornerRadius="0,0,30,30"
                                   Padding="20,45,20,25"
                                   HasShadow="True"
                                   Elevation="8">
                    <yummy:PancakeView.BackgroundGradientStops>
                        <yummy:GradientStopCollection>
                            <yummy:GradientStop Color="#002615" Offset="0"/>
                            <yummy:GradientStop Color="#004225" Offset="1"/>
                        </yummy:GradientStopCollection>
                    </yummy:PancakeView.BackgroundGradientStops>

                    <Grid RowSpacing="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="Collection Point"
                                   TextColor="White"
                                   FontSize="12"
                                   Opacity="0.8"/>
                            <Label x:Name="CollectionPointLabel"
                                   Text="—"
                                   TextColor="White"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"/>
                            <Label x:Name="AgentNameLabel"
                                   Text="—"
                                   TextColor="White"
                                   FontSize="14"
                                   Opacity="0.9"/>
                        </StackLayout>

                        <Image Grid.Row="0"
                               Grid.Column="1"
                               Source="yobe.png"
                               HeightRequest="70"
                               WidthRequest="70"
                               Aspect="AspectFit"/>

                        <StackLayout Grid.Row="1"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     Orientation="Horizontal"
                                     Spacing="10">

                            <yummy:PancakeView BackgroundColor="#00D68F"
                                               CornerRadius="15"
                                               Padding="12,8"
                                               HorizontalOptions="Start">
                                <Label Text="● Livestock Agent"
                                       TextColor="White"
                                       FontSize="12"
                                       FontAttributes="Bold"/>
                            </yummy:PancakeView>

                            <yummy:PancakeView BackgroundColor="#33FFFFFF"
                                               CornerRadius="15"
                                               Padding="12,8"
                                               HorizontalOptions="Start">
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogoutTapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                                <Label Text="Logout"
                                       TextColor="White"
                                       FontSize="12"
                                       FontAttributes="Bold"/>
                            </yummy:PancakeView>
                        </StackLayout>
                    </Grid>
                </yummy:PancakeView>

                <!-- ── PRIMARY ACTION: NEW COLLECTION ── -->
                <yummy:PancakeView x:Name="CollectCard"
                                   CornerRadius="20"
                                   Padding="25"
                                   Margin="15,20,15,10"
                                   HasShadow="True"
                                   Elevation="12">
                    <yummy:PancakeView.BackgroundGradientStops>
                        <yummy:GradientStopCollection>
                            <yummy:GradientStop Color="#002615" Offset="0"/>
                            <yummy:GradientStop Color="#004225" Offset="1"/>
                        </yummy:GradientStopCollection>
                    </yummy:PancakeView.BackgroundGradientStops>
                    <yummy:PancakeView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCollectTapped"/>
                    </yummy:PancakeView.GestureRecognizers>

                    <Grid ColumnSpacing="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackLayout Grid.Column="0" Spacing="10">
                            <Label Text="Livestock Collection"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="Pick one or more services, set the quantity for each, and take payment on a single screen."
                                   FontSize="13"
                                   TextColor="White"
                                   Opacity="0.95"
                                   LineBreakMode="WordWrap"/>

                            <yummy:PancakeView CornerRadius="25"
                                               BackgroundColor="ForestGreen"
                                               Padding="18,12"
                                               Margin="0,8,0,0"
                                               HorizontalOptions="Start">
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCollectTapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <Label Text="Start Collection"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           VerticalOptions="Center"/>
                                    <Label Text="→"
                                           FontSize="18"
                                           TextColor="White"
                                           VerticalOptions="Center"/>
                                </StackLayout>
                            </yummy:PancakeView>
                        </StackLayout>
                    </Grid>
                </yummy:PancakeView>

                <!-- ── SECONDARY TILES ── -->
                <Grid Padding="15,0,15,25" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <yummy:PancakeView Grid.Column="0"
                                       BackgroundColor="White"
                                       CornerRadius="18"
                                       Padding="18"
                                       HasShadow="True"
                                       Elevation="5">
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBalanceTapped"/>
                        </yummy:PancakeView.GestureRecognizers>
                        <StackLayout Spacing="6">
                            <Label Text="₦" FontSize="24" TextColor="#004225" FontAttributes="Bold"/>
                            <Label Text="Wallet Balance"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#2C3E50"/>
                            <Label x:Name="BalanceLabel"
                                   Text="Tap to refresh"
                                   FontSize="12"
                                   TextColor="#7F8C8D"/>
                        </StackLayout>
                    </yummy:PancakeView>

                    <yummy:PancakeView Grid.Column="1"
                                       BackgroundColor="White"
                                       CornerRadius="18"
                                       Padding="18"
                                       HasShadow="True"
                                       Elevation="5">
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped"/>
                        </yummy:PancakeView.GestureRecognizers>
                        <StackLayout Spacing="6">
                            <Label Text="⚙" FontSize="24" TextColor="#004225"/>
                            <Label Text="Settings"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#2C3E50"/>
                            <Label Text="PIN &amp; password"
                                   FontSize="12"
                                   TextColor="#7F8C8D"/>
                        </StackLayout>
                    </yummy:PancakeView>
                </Grid>

                <Label Text="POWERED BY OSOFTPAY"
                       FontSize="11"
                       TextColor="#B0B7BF"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,25"/>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
