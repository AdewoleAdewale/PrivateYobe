<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="YIRS.Views.Livestock.VerifyLivestock"
             BackgroundColor="#F3F5F9"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <ScrollView>
            
            
            <StackLayout Spacing="0">

                <!-- ═══════════════ HEADER ═══════════════ -->
                <yummy:PancakeView CornerRadius="0,0,24,24"
                                   Padding="18,45,18,26"
                                   HasShadow="True"
                                   Elevation="8">
                    <yummy:PancakeView.BackgroundGradientStops>
                        <yummy:GradientStopCollection>
                            <yummy:GradientStop Color="#002615" Offset="0"/>
                            <yummy:GradientStop Color="#004225" Offset="1"/>
                        </yummy:GradientStopCollection>
                    </yummy:PancakeView.BackgroundGradientStops>

                    <StackLayout Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
                                   Text="←"
                                   FontSize="26"
                                   TextColor="White"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <StackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Verify Transaction"
                                       TextColor="White"
                                       FontSize="20"
                                       FontAttributes="Bold"/>
                                <Label Text="Confirm a livestock receipt is genuine"
                                       TextColor="White"
                                       FontSize="11.5"
                                       Opacity="0.85"/>
                            </StackLayout>
                        </Grid>
                    </StackLayout>
                </yummy:PancakeView>

                <!-- ═══════════════ SEARCH CARD ═══════════════ -->
                <yummy:PancakeView Margin="16,-16,16,0"
                                   Padding="18"
                                   BackgroundColor="White"
                                   CornerRadius="16"
                                   HasShadow="True"
                                   Elevation="10">
                    <StackLayout Spacing="12">
                        <Label Text="TRANSACTION REFERENCE"
                               FontSize="10.5"
                               FontAttributes="Bold"
                               TextColor="#95A5A6"/>

                        <yummy:PancakeView BackgroundColor="#F7F9FA"
                                           CornerRadius="12"
                                           BorderThickness="1"
                                           BorderColor="#E4E9EC"
                                           Padding="14,2">
                            <Entry x:Name="ReferenceEntry"
                                   Placeholder="e.g. 639214374384661473"
                                   PlaceholderColor="#B0B7BF"
                                   Keyboard="Numeric"
                                   FontSize="15"
                                   TextColor="#22313F"
                                   Completed="OnVerifyTapped"/>
                        </yummy:PancakeView>

                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <yummy:PancakeView x:Name="PasteChip"
                                               BackgroundColor="#EDF2F0"
                                               CornerRadius="14"
                                               Padding="14,7">
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPasteTapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                                <Label Text="Paste" FontSize="12" FontAttributes="Bold" TextColor="#004225"/>
                            </yummy:PancakeView>

                            <yummy:PancakeView x:Name="ClearChip"
                                               BackgroundColor="#EDF2F0"
                                               CornerRadius="14"
                                               Padding="14,7">
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnClearTapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                                <Label Text="Clear" FontSize="12" FontAttributes="Bold" TextColor="#004225"/>
                            </yummy:PancakeView>
                        </StackLayout>

                        <Label Text="Search window"
                               FontSize="10.5"
                               FontAttributes="Bold"
                               TextColor="#95A5A6"
                               Margin="0,4,0,0"/>

                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <yummy:PancakeView x:Name="Window30"
                                               BackgroundColor="#EDF2F0"
                                               CornerRadius="14"
                                               Padding="14,7">
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWindowTapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                                <Label Text="30 days" FontSize="12" FontAttributes="Bold" TextColor="#004225"/>
                            </yummy:PancakeView>

                            <yummy:PancakeView x:Name="Window90"
                                               BackgroundColor="#004225"
                                               CornerRadius="14"
                                               Padding="14,7">
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWindowTapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                                <Label Text="90 days" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                            </yummy:PancakeView>

                            <yummy:PancakeView x:Name="Window365"
                                               BackgroundColor="#EDF2F0"
                                               CornerRadius="14"
                                               Padding="14,7">
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWindowTapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                                <Label Text="1 year" FontSize="12" FontAttributes="Bold" TextColor="#004225"/>
                            </yummy:PancakeView>
                        </StackLayout>

                        <yummy:PancakeView BackgroundColor="#004225"
                                           CornerRadius="14"
                                           Padding="0,15"
                                           Margin="0,6,0,0">
                            <yummy:PancakeView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVerifyTapped"/>
                            </yummy:PancakeView.GestureRecognizers>
                            <Label Text="VERIFY"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"/>
                        </yummy:PancakeView>
                    </StackLayout>
                </yummy:PancakeView>

                <!-- ═══════════════ RESULT ═══════════════ -->
                <yummy:PancakeView x:Name="ResultCard"
                                   Margin="16,16,16,0"
                                   Padding="20"
                                   BackgroundColor="White"
                                   CornerRadius="16"
                                   HasShadow="True"
                                   Elevation="6"
                                   IsVisible="False">
                    <StackLayout Spacing="14">

                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <yummy:PancakeView x:Name="ResultIconChip"
                                               WidthRequest="52"
                                               HeightRequest="52"
                                               CornerRadius="26"
                                               BackgroundColor="#E8F5EC">
                                <Label x:Name="ResultIconLabel"
                                       Text="✓"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       TextColor="#1E8E4E"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </yummy:PancakeView>

                            <StackLayout Spacing="3" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                <Label x:Name="ResultTitleLabel"
                                       Text="Verified"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#22313F"/>
                                <Label x:Name="ResultSubtitleLabel"
                                       Text=""
                                       FontSize="12"
                                       TextColor="#7F8C8D"
                                       LineBreakMode="WordWrap"/>
                            </StackLayout>
                        </StackLayout>

                        <StackLayout x:Name="ResultDetailSection" Spacing="14" IsVisible="False">
                            <BoxView BackgroundColor="#ECEFF1" HeightRequest="1"/>

                            <Label x:Name="ResultAmountLabel"
                                   Text="₦0.00"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   TextColor="#004225"/>

                            <StackLayout x:Name="ResultRowStack" Spacing="9"/>

                            <!--<yummy:PancakeView BackgroundColor="#ECEFF1"
                                               CornerRadius="24"
                                               Padding="0,14"
                                               Margin="0,4,0,0">
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnReprintTapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                                <Label Text="🖨  Print duplicate receipt"
                                       FontSize="13.5"
                                       FontAttributes="Bold"
                                       TextColor="#5D6D7E"
                                       HorizontalOptions="Center"/>
                            </yummy:PancakeView>-->
                        </StackLayout>
                    </StackLayout>
                </yummy:PancakeView>

                
                <Label Text="Verification searches transactions collected by this agent. A reference from another agent will not be found here."
                       FontSize="11"
                       TextColor="#004225"
                       Margin="24,16,24,30"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>
                
                
            </StackLayout>
            
            
        </ScrollView>

        <!-- ═══════════════ BUSY ═══════════════ -->
        <Grid x:Name="BusyOverlay"
              BackgroundColor="#99000000"
              IsVisible="False">
            <yummy:PancakeView BackgroundColor="White"
                               CornerRadius="16"
                               Padding="28,24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                <StackLayout Spacing="12">
                    <ActivityIndicator IsRunning="True" Color="#004225"/>
                    <Label x:Name="BusyLabel"
                           Text="Verifying…"
                           FontSize="13"
                           TextColor="#5D6D7E"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
            </yummy:PancakeView>
        </Grid>
    </Grid>
</ContentPage>
