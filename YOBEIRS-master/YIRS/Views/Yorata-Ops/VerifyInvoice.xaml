<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:renderers1="clr-namespace:YIRS.Renderers"
             x:Class="YIRS.Views.Yorata_Ops.VerifyInvoice"
             Padding="0"
             BackgroundColor="#F5F7FA"
             NavigationPage.HasNavigationBar="True">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryGreen">#004225</Color>
            <Color x:Key="AccentGold">#FFB800</Color>
            <Color x:Key="SuccessGreen">#10B981</Color>
            <Color x:Key="PendingOrange">#F59E0B</Color>
            <Color x:Key="ErrorRed">#EF4444</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#1F2937</Color>
            <Color x:Key="TextSecondary">#6B7280</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header Section -->
        <yummy:PancakeView Grid.Row="0" 
                          BackgroundColor="{StaticResource PrimaryGreen}"
                          CornerRadius="0,0,30,30"
                          Padding="20,40,20,30">
            <StackLayout Spacing="10">
                <Label Text="Transaction Verification"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>
                <Label Text="Verify your Invoice transaction status"
                       FontSize="14"
                       TextColor="#B8D4C8"
                       HorizontalTextAlignment="Center"/>
            </StackLayout>
        </yummy:PancakeView>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="20,20,20,20">
            <StackLayout Spacing="20">

                <!-- Search Card -->
                <yummy:PancakeView BackgroundColor="{StaticResource CardBackground}"
                                  CornerRadius="20"
                                  Padding="25"
                                  Elevation="8"
                                  HasShadow="True">
                    <StackLayout Spacing="15">
                        <Label Text="Enter Invoice Number"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>

                        <yummy:PancakeView BackgroundColor="#F9FAFB"
                                          BorderColor="{StaticResource PrimaryGreen}"
                                          BorderThickness="2"
                                          CornerRadius="15"
                                          Padding="15,0">
                            <renderers1:BorderlessEntry x:Name="InvoiceEntry"
                                                       Placeholder="e.g., 281379051740"
                                                       PlaceholderColor="{StaticResource TextSecondary}"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       FontSize="16"
                                                       Keyboard="Numeric"
                                                       ClearButtonVisibility="WhileEditing"
                                                       HeightRequest="50"/>
                        </yummy:PancakeView>

                        <Button x:Name="VerifyButton"
                                Text="VERIFY TRANSACTION"
                                BackgroundColor="{StaticResource PrimaryGreen}"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"
                                CornerRadius="15"
                                HeightRequest="55"
                                Clicked="OnVerifyClicked"/>
                    </StackLayout>
                </yummy:PancakeView>

                <!-- Loading Indicator -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                 IsVisible="False"
                                 IsRunning="False"
                                 Color="{StaticResource PrimaryGreen}"
                                 HeightRequest="50"/>

                <!-- Result Card -->
                <yummy:PancakeView x:Name="ResultCard"
                                  IsVisible="False"
                                  BackgroundColor="{StaticResource CardBackground}"
                                  CornerRadius="20"
                                  Padding="0"
                                  Elevation="8"
                                  HasShadow="True">
                    <StackLayout Spacing="0">

                        <!-- Status Header -->
                        <yummy:PancakeView x:Name="StatusHeader"
                                          CornerRadius="20,20,0,0"
                                          Padding="25,30">
                            <StackLayout Spacing="15" HorizontalOptions="Center">
                                <Frame x:Name="StatusIconFrame"
                                       CornerRadius="40"
                                       Padding="0"
                                       HeightRequest="80"
                                       WidthRequest="80"
                                       HasShadow="False"
                                       HorizontalOptions="Center">
                                    <Label x:Name="StatusIcon"
                                           FontSize="40"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Frame>

                                <Label x:Name="StatusLabel"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"/>

                                <Label x:Name="StatusMessage"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center"
                                       Opacity="0.8"/>
                            </StackLayout>
                        </yummy:PancakeView>

                        <!-- Transaction Details -->
                        <StackLayout Padding="25,20" Spacing="15">

                            <BoxView HeightRequest="1" 
                                    BackgroundColor="#E5E7EB"
                                    Margin="0,0,0,10"/>

                            <!-- Invoice Number -->
                            <Grid ColumnDefinitions="*,Auto" RowSpacing="5">
                                <Label Text="Invoice Number"
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Label x:Name="InvoiceLabel"
                                       Grid.Column="1"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"/>
                            </Grid>

                            <!-- Amount -->
                            <Grid ColumnDefinitions="*,Auto" RowSpacing="5">
                                <Label Text="Amount"
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Label x:Name="AmountLabel"
                                       Grid.Column="1"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryGreen}"/>
                            </Grid>

                            <!-- Verification Time -->
                            <Grid ColumnDefinitions="*,Auto" RowSpacing="5">
                                <Label Text="Verified On"
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Label x:Name="DateLabel"
                                       Grid.Column="1"
                                       FontSize="14"
                                       TextColor="{StaticResource TextPrimary}"/>
                            </Grid>

                            <!-- Print Button (Only for Successful) -->
                            <Button x:Name="PrintButton"
                                    IsVisible="False"
                                    Text="PRINT RECEIPT"
                                    BackgroundColor="{StaticResource AccentGold}"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    CornerRadius="15"
                                    HeightRequest="55"
                                    Margin="0,15,0,0"
                                    Clicked="OnPrintClicked"/>

                            <!-- Retry Button (For Pending/Failed) -->
                            <Button x:Name="RetryButton"
                                    IsVisible="False"
                                    Text="VERIFY AGAIN"
                                    BackgroundColor="{StaticResource PrimaryGreen}"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    CornerRadius="15"
                                    HeightRequest="55"
                                    Margin="0,15,0,0"
                                    Clicked="OnVerifyClicked"/>
                        </StackLayout>
                    </StackLayout>
                </yummy:PancakeView>

                <!-- Help Card -->
                <yummy:PancakeView BackgroundColor="#FEF3C7"
                                  CornerRadius="15"
                                  Padding="20"
                                  Margin="0,10,0,20">
                    <StackLayout Spacing="8" Orientation="Horizontal">
                        <Label Text="ℹ️"
                               FontSize="20"
                               VerticalOptions="Start"/>
                        <Label Text="Enter your invoice number to verify the transaction status. Successful transactions can be printed immediately."
                               FontSize="13"
                               TextColor="#92400E"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center"
                               HorizontalOptions="FillAndExpand"/>
                    </StackLayout>
                </yummy:PancakeView>

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>