<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YIRS.Views.Yorata_Ops.History"  
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             Padding="0"
             BackgroundColor="#004225"
             NavigationPage.HasNavigationBar="True">

    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <StackLayout Spacing="0">

            <!-- Header Section -->
            <StackLayout Padding="20,15,20,20" BackgroundColor="#004225">
                <Label Text="YORATA TRANSACTION HISTORY" 
                       TextColor="White" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       HorizontalTextAlignment="Center"/>
                <Label Text="View and manage your Yorata transaction records" 
                       TextColor="#B8E6D5" 
                       FontSize="13" 
                       HorizontalTextAlignment="Center"
                       Margin="0,5,0,0"/>
            </StackLayout>

            <!-- Main Content Card -->
            <yummy:PancakeView
                Margin="0"
                Padding="0"
                BackgroundColor="White"
                CornerRadius="25,25,0,0"
                VerticalOptions="FillAndExpand"
                HasShadow="True"
                Elevation="10">

                <StackLayout Spacing="0" Padding="20,25,20,20">

                    <!-- Date Range Section -->
                    <yummy:PancakeView
                        BackgroundColor="#F5F7FA"
                        CornerRadius="12"
                        Padding="15"
                        Margin="0,0,0,15">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="10">

                            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="Select Date Range" 
                                   FontFamily="OpenSans" 
                                   TextColor="#004225"  
                                   FontAttributes="Bold" 
                                   FontSize="14"/>

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="FROM" 
                                   FontSize="12" 
                                   TextColor="#666666"
                                   VerticalOptions="Center"/>

                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="TO" 
                                   FontSize="12" 
                                   TextColor="#666666"
                                   VerticalOptions="Center"/>

                            <yummy:PancakeView Grid.Row="2" Grid.Column="0"
                                BackgroundColor="White"
                                CornerRadius="8"
                                Padding="10,5">
                                <DatePicker x:Name="startDatePicker" 
                                            MaximumDate="12/31/2029" 
                                            FontSize="13"  
                                            Format="MMM dd, yyyy"
                                            TextColor="#004225"/>
                            </yummy:PancakeView>

                            <yummy:PancakeView Grid.Row="2" Grid.Column="1"
                                BackgroundColor="White"
                                CornerRadius="8"
                                Padding="10,5">
                                <DatePicker x:Name="endDatePicker" 
                                            MinimumDate="01/01/2020" 
                                            FontSize="13"   
                                            Format="MMM dd, yyyy"
                                            TextColor="#004225"/>
                            </yummy:PancakeView>

                            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                    Text="SEARCH TRANSACTIONS" 
                                    CornerRadius="10" 
                                    HeightRequest="48" 
                                    BackgroundColor="#004225" 
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Clicked="Button_Clicked"
                                    Margin="0,8,0,0"/>
                        </Grid>
                    </yummy:PancakeView>

                    <!-- Search Box -->
                    <yummy:PancakeView
                        BackgroundColor="#F5F7FA"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,15">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" 
                                   Text="🔍" 
                                   FontSize="18"
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="1"
                                   x:Name="searchEntry"
                                   Placeholder="Search by transaction ID, service, vehicle type or number..."
                                   PlaceholderColor="#999999"
                                   TextColor="#333333"
                                   FontSize="13"
                                   TextChanged="SearchEntry_TextChanged"
                                   BackgroundColor="Transparent"/>
                        </Grid>
                    </yummy:PancakeView>

                    <!-- ═══ Transaction Summary Panel ═══ -->
                    <yummy:PancakeView x:Name="SummaryPanel"
                                       IsVisible="False"
                                       CornerRadius="14"
                                       Elevation="4"
                                       Padding="0"
                                       Margin="0,0,0,18"
                                       BackgroundColor="White"
                                       BorderColor="#E5E7EB"
                                       BorderThickness="1">
                        <StackLayout Spacing="0">

                            <!-- Panel Header -->
                            <yummy:PancakeView CornerRadius="14,14,0,0" Padding="16,12">
                                <yummy:PancakeView.BackgroundGradientStops>
                                    <yummy:GradientStopCollection>
                                        <yummy:GradientStop Color="#004225" Offset="0"/>
                                        <yummy:GradientStop Color="#006837" Offset="1"/>
                                    </yummy:GradientStopCollection>
                                </yummy:PancakeView.BackgroundGradientStops>
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <Label Text="+" FontSize="16" VerticalOptions="Center"/>
                                    <Label Text="YORATA SUMMARY"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           CharacterSpacing="1"
                                           VerticalOptions="Center"/>
                                </StackLayout>
                            </yummy:PancakeView>

                            <!-- Stats Row -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="0">

                                <!-- Count -->
                                <StackLayout Grid.Column="0" Padding="14,14" Spacing="3" HorizontalOptions="Center">
                                    <Label x:Name="SummaryTotalCount"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#004225"
                                           HorizontalTextAlignment="Center"/>
                                    <Label Text="Transactions"
                                           FontSize="11"
                                           TextColor="#6B7280"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>

                                <BoxView Grid.Column="0"
                                         WidthRequest="1"
                                         BackgroundColor="#E5E7EB"
                                         HorizontalOptions="End"
                                         VerticalOptions="FillAndExpand"/>

                                <!-- Total Amount -->
                                <StackLayout Grid.Column="1" Padding="14,14" Spacing="3" HorizontalOptions="Center">
                                    <Label x:Name="SummaryTotalAmount"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#D32F2F"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="Total Amount"
                                           FontSize="11"
                                           TextColor="#6B7280"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>

                                <BoxView Grid.Column="1"
                                         WidthRequest="1"
                                         BackgroundColor="#E5E7EB"
                                         HorizontalOptions="End"
                                         VerticalOptions="FillAndExpand"/>

                                <!-- Date Range -->
                                <StackLayout Grid.Column="2" Padding="14,14" Spacing="3" HorizontalOptions="Center">
                                    <Label x:Name="SummaryDateRange"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#004225"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"/>
                                    <Label Text="Date Range"
                                           FontSize="11"
                                           TextColor="#6B7280"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </Grid>

                            <!-- ViewModel summary badge -->
                            <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>
                            <StackLayout Orientation="Horizontal" Padding="14,10" Spacing="8">
                                <Label Text="🚌" FontSize="13"/>
                                <Label Text="{Binding Summary}"
                                       TextColor="#004225"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       VerticalTextAlignment="Center"/>
                            </StackLayout>
                        </StackLayout>
                    </yummy:PancakeView>

                    <!-- Transaction List -->
                    <ListView x:Name="listView" 
                              SeparatorVisibility="None"
                              HasUnevenRows="True" 
                              ItemsSource="{Binding Transactions}"
                              BackgroundColor="Transparent"
                              SelectionMode="None"
                              RowHeight="-1"
                              CachingStrategy="RecycleElement">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <yummy:PancakeView 
                                        HasShadow="True" 
                                        BackgroundColor="White" 
                                        CornerRadius="12"
                                        Margin="0,0,0,12"
                                        Padding="0"
                                        BorderColor="#E0E0E0"
                                        BorderThickness="1">

                                        <Grid Padding="15" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*">

                                            <!-- Header Row -->
                                            <StackLayout Grid.Row="0" Grid.Column="0"
                                                         Orientation="Horizontal" 
                                                         Spacing="8"
                                                         Margin="0,0,0,10">
                                                <Label Text="+" 
                                                       FontSize="20"
                                                       VerticalOptions="Center"/>
                                                <Label Text="YORATA" 
                                                       TextColor="#004225" 
                                                       FontSize="14" 
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                                <BoxView BackgroundColor="#E0E0E0" 
                                                         WidthRequest="1" 
                                                         HeightRequest="20"
                                                         Margin="5,0"/>
                                                <Label Text="{Binding ServiceName}" 
                                                       TextColor="Black" 
                                                       FontSize="12"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="FillAndExpand"
                                                       LineBreakMode="TailTruncation"/>
                                            </StackLayout>

                                            <!-- Transaction Details -->
                                            <StackLayout Grid.Row="1" Grid.Column="0" Spacing="6">

                                                <Grid ColumnDefinitions="110,*">
                                                    <Label Grid.Column="0" 
                                                           Text="Transaction ID:" 
                                                           FontSize="12" 
                                                           FontAttributes="Bold" 
                                                           TextColor="#004225"/>
                                                    <Label Grid.Column="1" 
                                                           Text="{Binding TransactionId}" 
                                                           TextColor="Black" 
                                                           FontSize="12"
                                                           LineBreakMode="TailTruncation"/>
                                                </Grid>

                                                <Label Text="{Binding DisplayInfo}" 
                                                       TextColor="Red" 
                                                       FontSize="12"
                                                       LineBreakMode="WordWrap"/>

                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Label Grid.Column="0" 
                                                           Text="Amount: " 
                                                           FontSize="13" 
                                                           FontAttributes="Bold" 
                                                           TextColor="#004225"/>
                                                    <Label Grid.Column="1" 
                                                           Text="{Binding Amount, StringFormat='₦{0:N2}'}" 
                                                           TextColor="#D32F2F" 
                                                           FontSize="14"
                                                           FontAttributes="Bold"/>
                                                </Grid>

                                                <Label Text="{Binding DateRecorded, StringFormat='Date: {0:MMM dd, yyyy h:mm tt}'}" 
                                                       TextColor="Black" 
                                                       FontSize="11"/>
                                            </StackLayout>

                                            <!-- Reprint Button -->
                                            <Button Grid.Row="2" Grid.Column="0"
                                                    Text=" REPRINT RECEIPT" 
                                                    BackgroundColor="#004225"
                                                    TextColor="White"
                                                    CornerRadius="8"
                                                    HeightRequest="42"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    Margin="0,10,0,0"
                                                    Clicked="ReprintButton_Clicked"/>
                                        </Grid>
                                    </yummy:PancakeView>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <ListView.Footer>
                            <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
                        </ListView.Footer>
                    </ListView>

                </StackLayout>
            </yummy:PancakeView>
        </StackLayout>
    </ScrollView>
</ContentPage>
