<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" 
             xmlns:dxui="http://dips.xamarin.ui.com" 
             xmlns:controls="clr-namespace:CarouselView.FormsPlugin.Abstractions;assembly=CarouselView.FormsPlugin.Abstractions"
             x:Class="YIRS.Views.Yorata_Ops.Dashboard"    
             NavigationPage.HasNavigationBar="False">

    <dxui:ModalityLayout Opacity="10" OverlayColor="Transparent">
        <RefreshView x:Name="refreshView"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="#006837">
            <ScrollView>
                <StackLayout Orientation="Vertical" Spacing="0" Padding="0">

                    <!-- ══ Header Section ══ -->
                    <yummy:PancakeView Padding="20,50,20,35">
                        <yummy:PancakeView.BackgroundGradientStops>
                            <yummy:GradientStopCollection>
                                <yummy:GradientStop Color="#004225" Offset="0"/>
                                <yummy:GradientStop Color="#004225" Offset="0.5"/>
                                <yummy:GradientStop Color="#002615" Offset="1"/>
                            </yummy:GradientStopCollection>
                        </yummy:PancakeView.BackgroundGradientStops>

                        <Grid RowSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Header Row -->
                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <yummy:PancakeView BackgroundColor="White"
                                                       WidthRequest="45" HeightRequest="45"
                                                       CornerRadius="12" Padding="6">
                                        <Image Source="yobe.png" Aspect="AspectFit" />
                                    </yummy:PancakeView>
                                    <StackLayout VerticalOptions="Center" Spacing="2">
                                        <Label Text="YOBE STATE GOVERNMENT"
                                               FontSize="18" FontAttributes="Bold"
                                               TextColor="White" Opacity="0.9"/>
                                        <Label Text="Internal Revenue Service"
                                               FontSize="10" TextColor="White" Opacity="0.7" />
                                    </StackLayout>
                                </StackLayout>

                                <yummy:PancakeView Grid.Column="2"
                                                   BackgroundColor="White"
                                                   WidthRequest="40" HeightRequest="40"
                                                   CornerRadius="20" Padding="8" Opacity="0.95">
                                    <Image Source="osoft.png" Aspect="AspectFit">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnProfileTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </yummy:PancakeView>
                            </Grid>

                            <!-- Welcome Message -->
                            <StackLayout Grid.Row="1" Spacing="8">
                                <Label Text="Welcome back,"
                                       FontSize="13" TextColor="White" Opacity="0.85" />
                                <Label x:Name="WelcomeMessage"
                                       FontAttributes="Bold" FontSize="24" TextColor="White" />
                                <Label x:Name="agent2" FontSize="11" TextColor="White" Opacity="0.8">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="ℹ️ " />
                                            <Span Text="Last login: " />
                                            <Span x:Name="lastLoginSpan" Text="Nov 03, 2025" FontAttributes="Bold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </StackLayout>
                        </Grid>
                    </yummy:PancakeView>

                    <!-- ══ Date & Time Card ══ -->
                    <yummy:PancakeView Margin="20,-20,20,20"
                                       BackgroundColor="White" CornerRadius="15"
                                       Padding="18,14" Elevation="8" HasShadow="True">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="📅" FontSize="20"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   WidthRequest="45" HeightRequest="45"/>
                            <Label Grid.Column="1" x:Name="dateTimeLabel"
                                   Text="Monday, November 03, 2025 • 2:55 PM"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="#1F2937" VerticalOptions="Center" />
                        </Grid>
                    </yummy:PancakeView>

                    <!-- ══ Main Action Cards (2 + 1 invoice row) ══ -->
                    <!-- Row 1: Category + Super Agent -->
                    <Grid Margin="20,0,20,15" RowSpacing="15" ColumnSpacing="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="140" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Category Card -->
                        <yummy:PancakeView Grid.Row="0" Grid.Column="0"
                                           CornerRadius="20" Elevation="10" HasShadow="True">
                            <yummy:PancakeView.BackgroundGradientStops>
                                <yummy:GradientStopCollection>
                                    <yummy:GradientStop Color="#065F46" Offset="0"/>
                                    <yummy:GradientStop Color="#064E3B" Offset="1"/>
                                </yummy:GradientStopCollection>
                            </yummy:PancakeView.BackgroundGradientStops>
                            <Grid Padding="18" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Text="📍" FontSize="26"
                                       HorizontalOptions="Start" WidthRequest="50" HeightRequest="50"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                <Label Grid.Row="2" x:Name="cat" Text="YORATA"
                                       FontSize="16" FontAttributes="Bold" TextColor="White" />
                                <Label Grid.Row="2" Text="Collection Points"
                                       FontSize="10" TextColor="White" Opacity="0.7" Margin="0,20,0,0" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </yummy:PancakeView>

                        <!-- Super Agent Card -->
                        <yummy:PancakeView Grid.Row="0" Grid.Column="1"
                                           CornerRadius="20" Elevation="10" HasShadow="True">
                            <yummy:PancakeView.BackgroundGradientStops>
                                <yummy:GradientStopCollection>
                                    <yummy:GradientStop Color="#F59E0B" Offset="0"/>
                                    <yummy:GradientStop Color="#D97706" Offset="1"/>
                                </yummy:GradientStopCollection>
                            </yummy:PancakeView.BackgroundGradientStops>
                            <Grid Padding="18" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Text="👥" FontSize="26"
                                       HorizontalOptions="Start" WidthRequest="50" HeightRequest="50"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                <Label Grid.Row="2" Text="YORATA TEST"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="White" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="2" Text="Super Agents"
                                       FontSize="10" TextColor="White" Opacity="0.7" Margin="0,20,0,0" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_6" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </yummy:PancakeView>
                    </Grid>

                    <!-- Row 2: Invoice Card (full width) -->
                 
                    <!-- ══ Quick Actions Header ══ -->
                    <Grid Margin="20,10,20,15" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Text="Quick Actions"
                               FontAttributes="Bold" FontSize="18"
                               TextColor="#1F2937" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="+" FontSize="24"
                               FontAttributes="Bold" TextColor="#00B969" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_3" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- ══ Quick Action Items ══ -->
                    <StackLayout Margin="20,0,20,20" Spacing="12">

                        <!-- Services -->
                        <yummy:PancakeView BackgroundColor="White" CornerRadius="18"
                                           Padding="16" Elevation="4" HasShadow="True">
                            <Grid ColumnSpacing="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <yummy:PancakeView Grid.Column="0"
                                                   BackgroundGradientStartColor="#D1FAE5"
                                                   BackgroundGradientEndColor="#A7F3D0"
                                                   WidthRequest="52" HeightRequest="52"
                                                   CornerRadius="14" Padding="10">
                                    <Image Source="enumerate.png" Aspect="AspectFit" />
                                </yummy:PancakeView>
                                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="Services" FontAttributes="Bold"
                                           FontSize="15" TextColor="#1F2937" />
                                    <Label Text="Make Payment With Services and you can generate invoice"
                                           FontSize="10" TextColor="#6B7280" />
                                </StackLayout>
                                <Label Grid.Column="2" Text="+" FontSize="28"
                                       TextColor="#00B969" VerticalOptions="Center" HorizontalOptions="End" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </yummy:PancakeView>

                        <!-- Verify Invoice -->
                        <yummy:PancakeView BackgroundColor="White" CornerRadius="18"
                                           Padding="16" Elevation="4" HasShadow="True">
                            <Grid ColumnSpacing="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <yummy:PancakeView Grid.Column="0"
                                                   BackgroundGradientStartColor="#FEF3C7"
                                                   BackgroundGradientEndColor="#FDE68A"
                                                   WidthRequest="52" HeightRequest="52"
                                                   CornerRadius="14" Padding="10">
                                    <Image Source="WHTax.png" Aspect="AspectFit" />
                                </yummy:PancakeView>
                                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="Verify Invoice" FontAttributes="Bold"
                                           FontSize="15" TextColor="#1F2937" />
                                    <Label Text="You can verify invoice number with invoice details"
                                           FontSize="10" TextColor="#6B7280" />
                                </StackLayout>
                                <Label Grid.Column="2" Text="+" FontSize="28"
                                       TextColor="#F59E0B" VerticalOptions="Center" HorizontalOptions="End" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_5" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </yummy:PancakeView>

                        <!-- Invoice History -->
                        <yummy:PancakeView BackgroundColor="White" CornerRadius="18"
                                           Padding="16" Elevation="4" HasShadow="True">
                            <Grid ColumnSpacing="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <yummy:PancakeView Grid.Column="0"
                                                   BackgroundGradientStartColor="#DBEAFE"
                                                   BackgroundGradientEndColor="#BFDBFE"
                                                   WidthRequest="52" HeightRequest="52"
                                                   CornerRadius="14" Padding="10">
                                    <Image Source="BIRSPayment.png" Aspect="AspectFit" />
                                </yummy:PancakeView>
                                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="Invoice History" FontAttributes="Bold"
                                           FontSize="15" TextColor="#1F2937" />
                                    <Label Text="You can view all generated invoice history with date range"
                                           FontSize="10" TextColor="#6B7280" />
                                </StackLayout>
                                <Label Grid.Column="2" Text="+" FontSize="28"
                                       TextColor="#3B82F6" VerticalOptions="Center" HorizontalOptions="End" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_4" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </yummy:PancakeView>

                        <!-- Agent History (new) -->
                        <yummy:PancakeView BackgroundColor="White" CornerRadius="18"
                                           Padding="16" Elevation="4" HasShadow="True">
                            <Grid ColumnSpacing="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <yummy:PancakeView Grid.Column="0"
                                                   BackgroundGradientStartColor="#EDE9FE"
                                                   BackgroundGradientEndColor="#DDD6FE"
                                                   WidthRequest="52" HeightRequest="52"
                                                   CornerRadius="14" Padding="10">
                                    <Image Source="YobeCollection.png" Aspect="AspectFit" />
                                </yummy:PancakeView>
                                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="Transaction History" FontAttributes="Bold"
                                           FontSize="15" TextColor="#1F2937" />
                                    <Label Text="View all your Yorata payment transactions"
                                           FontSize="10" TextColor="#6B7280" />
                                </StackLayout>
                                <Label Grid.Column="2" Text="+" FontSize="28"
                                       TextColor="#7C3AED" VerticalOptions="Center" HorizontalOptions="End" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_7" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </yummy:PancakeView>

                    </StackLayout>

                    <!-- ══ Balance Display ══ -->
                    <yummy:PancakeView Margin="20,10,20,20"
                                       CornerRadius="20" BackgroundColor="White"
                                       BorderColor="#00B969" Elevation="15"
                                       HasShadow="True" BorderThickness="2">
                        <Grid Padding="25,20" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Text="AVAILABLE BALANCE"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#6B7280" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="1" x:Name="cashoutB"
                                   TextColor="#00B969" FontSize="38"
                                   FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <yummy:PancakeView Grid.Row="2"
                                               BackgroundColor="#F0FDF4" CornerRadius="10" Padding="15,10">
                                <Label x:Name="cllpoint" FontSize="11"
                                       TextColor="#065F46" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                            </yummy:PancakeView>
                        </Grid>
                    </yummy:PancakeView>

                    <!-- ══ Recent Transactions ══ -->
                    <StackLayout Margin="20,0,20,20" Spacing="15">

                        <!-- Section Header -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="Recent Transactions"
                                   FontAttributes="Bold" FontSize="18" TextColor="#1F2937"
                                   VerticalOptions="Center"/>
                            <!-- Refresh button -->
                            <Label Grid.Column="1" Text="↻" FontSize="22"
                                   FontAttributes="Bold" TextColor="#00B969"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRefreshTransactions_Tapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Search Bar -->
                        <yummy:PancakeView x:Name="searchBar"
                                           BackgroundColor="White"
                                           BorderColor="#E5E7EB" BorderThickness="1"
                                           CornerRadius="12" Elevation="2" HasShadow="True">
                            <SearchBar x:Name="searchEntry"
                                       Placeholder="Search transactions..."
                                       PlaceholderColor="#9CA3AF"
                                       TextColor="#1F2937"
                                       FontSize="13"
                                       BackgroundColor="Transparent" />
                        </yummy:PancakeView>

                        <!-- Loading indicator for transactions -->
                        <ActivityIndicator x:Name="transactionLoader"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="#004225"
                                           HeightRequest="30"
                                           HorizontalOptions="Center"/>

                        <!-- Transaction List
                             IMPORTANT: ItemsSource is set from code-behind directly.
                             HasUnevenRows="True" + no fixed HeightRequest so it sizes naturally. -->
                        <ListView x:Name="listView"
                                  BackgroundColor="Transparent"
                                  HasUnevenRows="True"
                       HeightRequest="250"
                                  SeparatorVisibility="None"
                                  IsVisible="False"
                                  CachingStrategy="RecycleElement"
                                  VerticalOptions="FillAndExpand">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <yummy:PancakeView BackgroundColor="White"
                                                           BorderColor="#E5E7EB" BorderThickness="1"
                                                           Padding="16" Margin="0,0,0,10"
                                                           Elevation="3" CornerRadius="14" HasShadow="True">
                                            <Grid RowSpacing="8" ColumnSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <yummy:PancakeView Grid.Row="0" Grid.Column="0"
                                                                   Grid.RowSpan="3"
                                                                   BackgroundGradientStartColor="#F0FDF4"
                                                                   BackgroundGradientEndColor="#DCFCE7"
                                                                   WidthRequest="48" HeightRequest="48"
                                                                   CornerRadius="12" Padding="8"
                                                                   VerticalOptions="Center">
                                                    <Image Source="yobe.png" Aspect="AspectFit" />
                                                </yummy:PancakeView>

                                                <!-- Service Name -->
                                                <Label Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding serviceName}"
                                                       FontAttributes="Bold" FontSize="14"
                                                       TextColor="#1F2937" LineBreakMode="TailTruncation"/>

                                                <!-- Amount -->
                                                <Label Grid.Row="0" Grid.Column="2"
                                                       Text="{Binding AmountFormatted}"
                                                       FontAttributes="Bold" FontSize="14"
                                                       TextColor="#00B969" VerticalOptions="Center" />

                                                <!-- Primary field (vehicle type / business) -->
                                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                       Text="{Binding primaryField}"
                                                       FontSize="12" TextColor="#6B7280"
                                                       LineBreakMode="TailTruncation"/>

                                                <!-- Date — pre-formatted string from code-behind -->
                                                <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                       Text="{Binding DateFormatted}"
                                                       FontSize="10" TextColor="#9CA3AF" />
                                            </Grid>
                                        </yummy:PancakeView>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty State -->
                        <yummy:PancakeView x:Name="emptyState"
                                           IsVisible="False"
                                           Padding="40" BackgroundColor="White"
                                           CornerRadius="16" Elevation="4" HasShadow="True">
                            <StackLayout Spacing="12" HorizontalOptions="Center">
                                <Label Text="📊" FontSize="48" HorizontalTextAlignment="Center" />
                                <Label Text="No Transactions Found"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="#1F2937" HorizontalTextAlignment="Center" />
                                <Label Text="Your transaction history will appear here"
                                       FontSize="12" TextColor="#6B7280"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </yummy:PancakeView>

                    </StackLayout>

                    <!-- ══ Footer ══ -->
                    <StackLayout Padding="20,20,20,40" Spacing="8">
                        <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="40,0" />
                        <Label Text="POWERED BY OSOFTPAY"
                               TextColor="#9CA3AF" FontSize="10"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </StackLayout>

                </StackLayout>
            </ScrollView>
        </RefreshView>

        <!-- ══ Floating Action Menu ══ -->
        <dxui:ModalityLayout.Behaviors>
            <dxui:FloatingActionMenuBehaviour Size="56"
                                              ExpandButtonBackgroundColor="#00B969"
                                              ExpandButtonText="⋮"
                                              ExpandButtonFontSize="24"
                                              ExpandButtonTextColor="White"
                                              XPosition=".88"
                                              YPosition=".92">

                <dxui:MenuButton BackgroundColor="#00B969"
                                 Text="PRINTER" TextColor="White"
                                 HeightRequest="50" Title="PRINTER">
                    <dxui:MenuButton.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_10" />
                    </dxui:MenuButton.GestureRecognizers>
                </dxui:MenuButton>

                <dxui:MenuButton BackgroundColor="#DC2626"
                                 Text="LOGOUT" TextColor="White"
                                 Title="LOGOUT" HeightRequest="50">
                    <dxui:MenuButton.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_9" />
                    </dxui:MenuButton.GestureRecognizers>
                </dxui:MenuButton>

            </dxui:FloatingActionMenuBehaviour>
        </dxui:ModalityLayout.Behaviors>

    </dxui:ModalityLayout>
</ContentPage>
