<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="YIRS.Views.Water.WaterRegistration"
             Title="New Connection"
             BackgroundColor="#F7F9FA">

    <ScrollView>
        <StackLayout Padding="16,20" Spacing="16">

            <yummy:PancakeView BackgroundColor="#063E2A" CornerRadius="16" Padding="18,16" HasShadow="True">
                <yummy:PancakeView.BackgroundGradientStops>
                    <yummy:GradientStopCollection>
                        <yummy:GradientStop Color="#063E2A" Offset="0"/>
                        <yummy:GradientStop Color="#00713F" Offset="1"/>
                    </yummy:GradientStopCollection>
                </yummy:PancakeView.BackgroundGradientStops>
                <Grid ColumnDefinitions="Auto, *">
                    <Frame Grid.Column="0" BackgroundColor="#1F5742" CornerRadius="22" HeightRequest="44" WidthRequest="44" Padding="0" HasShadow="False">
                        <Image Source="yobe" Margin="5" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <StackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center" Spacing="2">
                        <Label Text="Water Consumer Enumeration" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                        <Label Text="Register property &amp; generate customer ID" TextColor="#B0D5C7" FontSize="11"/>
                    </StackLayout>
                </Grid>
            </yummy:PancakeView>

            <!-- Card 1: Consumer Info -->
            <yummy:PancakeView BackgroundColor="White" CornerRadius="14" Padding="16" HasShadow="True">
                <StackLayout Spacing="14">
                    <Label Text="CONSUMER / OCCUPANT INFO" TextColor="#063E2A" FontAttributes="Bold" FontSize="12"/>

                    <Frame BackgroundColor="#F9FAFB" CornerRadius="8" Padding="12,2" HasShadow="False" BorderColor="#E8EBED">
                        <Entry x:Name="OccupantEntry" Placeholder="Full Name *" TextColor="#222" FontSize="14"/>
                    </Frame>
                    <Frame BackgroundColor="#F9FAFB" CornerRadius="8" Padding="12,2" HasShadow="False" BorderColor="#E8EBED">
                        <Entry x:Name="PhoneEntry" Placeholder="Phone Number *" Keyboard="Telephone" TextColor="#222" FontSize="14"/>
                    </Frame>
                    <Frame BackgroundColor="#F9FAFB" CornerRadius="8" Padding="12,2" HasShadow="False" BorderColor="#E8EBED">
                        <Entry x:Name="EmailEntry" Placeholder="Email Address (Optional)" Keyboard="Email" TextColor="#222" FontSize="14"/>
                    </Frame>
                </StackLayout>
            </yummy:PancakeView>

            <!-- Card 2: Location Info -->
            <yummy:PancakeView BackgroundColor="White" CornerRadius="14" Padding="16" HasShadow="True">
                <StackLayout Spacing="14">
                    <Label Text="PROPERTY LOCATION" TextColor="#063E2A" FontAttributes="Bold" FontSize="12"/>

                    <Frame BackgroundColor="#F9FAFB" CornerRadius="8" Padding="12,2" HasShadow="False" BorderColor="#E8EBED">
                        <Entry x:Name="AddressEntry" Placeholder="Street Address *" TextColor="#222" FontSize="14"/>
                    </Frame>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Frame Grid.Column="0" BackgroundColor="#F9FAFB" CornerRadius="8" Padding="12,2" HasShadow="False" BorderColor="#E8EBED">
                            <Entry x:Name="FlatNoEntry" Placeholder="Flat / Unit No" TextColor="#222" FontSize="14"/>
                        </Frame>
                        <Frame Grid.Column="1" BackgroundColor="#F9FAFB" CornerRadius="8" Padding="12,2" HasShadow="False" BorderColor="#E8EBED">
                            <Entry x:Name="LgaEntry" Placeholder="LGA" TextColor="#222" FontSize="14"/>
                        </Frame>
                    </Grid>
                    <Frame BackgroundColor="#F9FAFB" CornerRadius="8" Padding="12,2" HasShadow="False" BorderColor="#E8EBED">
                        <Entry x:Name="LocationEntry" Placeholder="Landmark / Description" TextColor="#222" FontSize="14"/>
                    </Frame>
                </StackLayout>
            </yummy:PancakeView>

            <!-- Card 3: Area & Tariff -->
            <yummy:PancakeView BackgroundColor="White" CornerRadius="14" Padding="16" HasShadow="True">
                <StackLayout Spacing="14">
                    <Label Text="AREA &amp; TARIFF PLAN" TextColor="#063E2A" FontAttributes="Bold" FontSize="12"/>

                    <Frame BackgroundColor="#F9FAFB" CornerRadius="8" Padding="10,0" HasShadow="False" BorderColor="#E8EBED">
                        <Picker x:Name="AreaPicker" ItemDisplayBinding="{Binding name}" Title="Select Resource Area" TextColor="#222"/>
                    </Frame>
                    <Frame BackgroundColor="#F9FAFB" CornerRadius="8" Padding="10,0" HasShadow="False" BorderColor="#E8EBED">
                        <Picker x:Name="ServicePicker" ItemDisplayBinding="{Binding serviceName}" Title="Select Tariff Service Plan" SelectedIndexChanged="OnServiceSelected" TextColor="#222"/>
                    </Frame>

                    <Frame BackgroundColor="#E3F7EF" CornerRadius="8" Padding="12" HasShadow="False">
                        <Label x:Name="EstimatedRateLabel" Text="Estimated Rate: ₦0.00 / month" TextColor="#0E8A57" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="Center"/>
                    </Frame>
                </StackLayout>
            </yummy:PancakeView>

            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" Color="#063E2A" HorizontalOptions="Center"/>

            <Button x:Name="SubmitBtn" Text="Register &amp; Print Slip" BackgroundColor="#063E2A" TextColor="White" 
                    FontAttributes="Bold" FontSize="15" CornerRadius="12" HeightRequest="52" Margin="0,4,0,20"
                    Clicked="OnSubmitRegistrationClicked"/>

        </StackLayout>
    </ScrollView>
</ContentPage>