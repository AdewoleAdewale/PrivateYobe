<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YIRS.Views.Water.WaterDashBoard"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F7F9FA">

    <Grid RowDefinitions="*, Auto">

        <!-- Main Scrollable Dashboard Content -->
        <ScrollView Grid.Row="0">
            <StackLayout Spacing="0">

                <!-- Dark Green Top Header Section -->
                <Frame BackgroundColor="#063E2A" CornerRadius="0" Padding="20,40,20,25" HasShadow="False">
                    <StackLayout Spacing="16">

                        <!-- User / Location Row -->
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" VerticalOptions="Center">
                            <Frame Grid.Column="0" BackgroundColor="#1F5742" CornerRadius="20" HeightRequest="40" WidthRequest="40" Padding="0" HasShadow="False">
                                <Label Text="WC" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <StackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                                <Label Text="Good day," TextColor="#A3C7B9" FontSize="11"/>
                                <Label x:Name="AgentNameLabel" Text="Water Revenue Agent" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                            </StackLayout>
                            <Frame Grid.Column="2" BackgroundColor="#1F5742" CornerRadius="18" HeightRequest="36" WidthRequest="36" Padding="0" HasShadow="False">
                                <Label Text="•••" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="14"/>
                            </Frame>
                            <Frame Grid.Column="3" BackgroundColor="#8B1E1E" CornerRadius="18" HeightRequest="36" WidthRequest="36" Padding="0" HasShadow="False" Margin="6,0,0,0">
                                <Label Text="⏻" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="14">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLogoutTapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Frame>
                        </Grid>

                        <!-- Station / Branch Badge -->
                        <Frame BackgroundColor="#0A4D35" CornerRadius="10" Padding="12,10" HasShadow="False">
                            <Grid ColumnDefinitions="4, *">
                                <BoxView Grid.Column="0" BackgroundColor="#E05324" CornerRadius="2" WidthRequest="4"/>
                                <StackLayout Grid.Column="1" Margin="8,0,0,0">
                                    <Label Text="YOBE STATE WATER CORPORATION" TextColor="White" FontAttributes="Bold" FontSize="12"/>
                                    <Label Text="WATER RESOURCE REVENUE &amp; ENUMERATION" TextColor="#B0D5C7" FontSize="10"/>
                                </StackLayout>
                            </Grid>
                        </Frame>

                        <!-- Metric Summary -->
                        <StackLayout Spacing="4">
                            <Label Text="Collected today" TextColor="#A3C7B9" FontSize="12"/>
                            <Label x:Name="CollectedTodayLabel" Text="₦0.00" TextColor="White" FontAttributes="Bold" FontSize="32"/>
                            <Label Text="Transactions recorded today" TextColor="#7EA695" FontSize="11"/>
                        </StackLayout>

                        <!-- 3-Column Metrics Grid -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Frame Grid.Column="0" BackgroundColor="#0A4D35" CornerRadius="10" Padding="10" HasShadow="False">
                                <StackLayout Spacing="2">
                                    <Label x:Name="PaymentsCountLabel" Text="0" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                                    <Label Text="Payments" TextColor="#96C2B0" FontSize="10"/>
                                </StackLayout>
                            </Frame>
                            <Frame Grid.Column="1" BackgroundColor="#0A4D35" CornerRadius="10" Padding="10" HasShadow="False">
                                <StackLayout Spacing="2">
                                    <Label x:Name="AvgTicketLabel" Text="—" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                                    <Label Text="Avg ticket" TextColor="#96C2B0" FontSize="10"/>
                                </StackLayout>
                            </Frame>
                            <Frame Grid.Column="2" BackgroundColor="#0A4D35" CornerRadius="10" Padding="10" HasShadow="False">
                                <StackLayout Spacing="2">
                                    <Label x:Name="WeeklyTotalLabel" Text="₦0" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                                    <Label Text="Last 7 days" TextColor="#96C2B0" FontSize="10"/>
                                </StackLayout>
                            </Frame>
                        </Grid>

                    </StackLayout>
                </Frame>

                <!-- Status Chips & Main Action Banner -->
                <StackLayout Padding="16,14" Spacing="14">

                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Frame BackgroundColor="#E3F7EF" CornerRadius="8" Padding="12,5" HasShadow="False">
                            <Label Text="● Online" TextColor="#0E8A57" FontSize="11" FontAttributes="Bold"/>
                        </Frame>
                        <Frame x:Name="PrinterStatusChip" BackgroundColor="#FDF0DF" CornerRadius="8" Padding="12,5" HasShadow="False">
                            <Label x:Name="PrinterStatusLabel" Text="Printer ready" TextColor="#C47314" FontSize="11" FontAttributes="Bold"/>
                        </Frame>
                    </StackLayout>

                    <!-- New Payment Banner Card -->
                    <Frame BackgroundColor="#063E2A" CornerRadius="14" Padding="16" HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNewPaymentTapped"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <StackLayout Grid.Column="0">
                                <Label Text="New water payment" TextColor="White" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="Lookup connection, select months, collect" TextColor="#B0D5C7" FontSize="11"/>
                            </StackLayout>
                            <Label Grid.Column="1" Text="➔" TextColor="White" FontSize="20" VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                    <!-- 4 Rounded Action Tabs -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <!-- Enumerate -->
                        <Frame Grid.Column="0" BackgroundColor="White" CornerRadius="16" Padding="8" HasShadow="True" BorderColor="#EFEFEF">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEnumerateTapped"/>
                            </Frame.GestureRecognizers>
                            <StackLayout HorizontalOptions="Center" Spacing="6">
                                <Frame BackgroundColor="#E0F5EE" CornerRadius="12" HeightRequest="44" WidthRequest="44" Padding="0" HasShadow="False" HorizontalOptions="Center">
                                    <Label Text="E" TextColor="#063E2A" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="Enumerate" FontSize="11" FontAttributes="Bold" TextColor="#333" HorizontalOptions="Center"/>
                            </StackLayout>
                        </Frame>

                        <!-- History -->
                        <Frame Grid.Column="1" BackgroundColor="White" CornerRadius="16" Padding="8" HasShadow="True" BorderColor="#EFEFEF">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHistoryTapped"/>
                            </Frame.GestureRecognizers>
                            <StackLayout HorizontalOptions="Center" Spacing="6">
                                <Frame BackgroundColor="#E5F0FF" CornerRadius="12" HeightRequest="44" WidthRequest="44" Padding="0" HasShadow="False" HorizontalOptions="Center">
                                    <Label Text="H" TextColor="#1B60C4" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="History" FontSize="11" FontAttributes="Bold" TextColor="#333" HorizontalOptions="Center"/>
                            </StackLayout>
                        </Frame>

                        <!-- Test Print -->
                        <Frame Grid.Column="2" BackgroundColor="White" CornerRadius="16" Padding="8" HasShadow="True" BorderColor="#EFEFEF">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTestPrintTapped"/>
                            </Frame.GestureRecognizers>
                            <StackLayout HorizontalOptions="Center" Spacing="6">
                                <Frame BackgroundColor="#FDF0DF" CornerRadius="12" HeightRequest="44" WidthRequest="44" Padding="0" HasShadow="False" HorizontalOptions="Center">
                                    <Label Text="T" TextColor="#C47314" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="Test print" FontSize="11" FontAttributes="Bold" TextColor="#333" HorizontalOptions="Center"/>
                            </StackLayout>
                        </Frame>

                        <!-- Settings -->
                        <Frame Grid.Column="3" BackgroundColor="White" CornerRadius="16" Padding="8" HasShadow="True" BorderColor="#EFEFEF">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsTapped"/>
                            </Frame.GestureRecognizers>
                            <StackLayout HorizontalOptions="Center" Spacing="6">
                                <Frame BackgroundColor="#F0EBFC" CornerRadius="12" HeightRequest="44" WidthRequest="44" Padding="0" HasShadow="False" HorizontalOptions="Center">
                                    <Label Text="S" TextColor="#6E44BA" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="Settings" FontSize="11" FontAttributes="Bold" TextColor="#333" HorizontalOptions="Center"/>
                            </StackLayout>
                        </Frame>
                    </Grid>

                    <!-- Recent Activity Section -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                        <Label Grid.Column="0" Text="Recent activity" FontAttributes="Bold" FontSize="16" TextColor="#1A1A1A"/>
                        <Label Grid.Column="1" Text="See all" TextColor="#063E2A" FontSize="12" FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHistoryTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <StackLayout x:Name="RecentActivityContainer" Spacing="8"/>
                </StackLayout>
            </StackLayout>
        </ScrollView>

        <!-- Modern Bottom Navigation Bar -->
        <Frame Grid.Row="1" BackgroundColor="White" CornerRadius="22" Margin="14,0,14,12" Padding="14,8" HasShadow="True" BorderColor="#EEEEEE">
            <Grid ColumnDefinitions="*,*,*,*,*">
                <!-- Home -->
                <StackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <Label Text="⌂" FontSize="19" TextColor="#4A3AFF" HorizontalOptions="Center"/>
                    <Label Text="Home" FontSize="10" TextColor="#4A3AFF" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <BoxView HeightRequest="3" WidthRequest="4" BackgroundColor="#4A3AFF" CornerRadius="2" HorizontalOptions="Center"/>
                </StackLayout>
                <!-- Enumerate -->
                <StackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEnumerateTapped"/>
                    </StackLayout.GestureRecognizers>
                    <Label Text="⊕" FontSize="18" TextColor="#8E92BC" HorizontalOptions="Center"/>
                    <Label Text="Enumerate" FontSize="10" TextColor="#8E92BC" HorizontalOptions="Center"/>
                </StackLayout>
                <!-- Pay -->
                <StackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNewPaymentTapped"/>
                    </StackLayout.GestureRecognizers>
                    <Label Text="◫" FontSize="18" TextColor="#8E92BC" HorizontalOptions="Center"/>
                    <Label Text="Pay" FontSize="10" TextColor="#8E92BC" HorizontalOptions="Center"/>
                </StackLayout>
                <!-- History -->
                <StackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryTapped"/>
                    </StackLayout.GestureRecognizers>
                    <Label Text="☷" FontSize="18" TextColor="#8E92BC" HorizontalOptions="Center"/>
                    <Label Text="History" FontSize="10" TextColor="#8E92BC" HorizontalOptions="Center"/>
                </StackLayout>
                <!-- Profile / Settings -->
                <StackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="2">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsTapped"/>
                    </StackLayout.GestureRecognizers>
                    <Label Text="👤" FontSize="18" TextColor="#8E92BC" HorizontalOptions="Center"/>
                    <Label Text="Profile" FontSize="10" TextColor="#8E92BC" HorizontalOptions="Center"/>
                </StackLayout>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>