<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:dxui="http://dips.xamarin.ui.com" xmlns:renderers1="clr-namespace:YIRS.Renderers"
             x:Class="YIRS.Views.Haulage.Registeration"             NavigationPage.HasNavigationBar="True"
             BackgroundColor="#F2F6F3"
             Padding="0">

    <dxui:ModalityLayout OverlayColor="Transparent" Opacity="10">

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <StackLayout Spacing="0">

                <!-- ══════════ GRADIENT HEADER ══════════ -->
                <yummy:PancakeView BackgroundGradientStartColor="#004225"
                                   BackgroundGradientEndColor="#004225"
                                   BackgroundGradientAngle="135"
                                   CornerRadius="0,0,30,30"
                                   Padding="24,50,24,30">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout Grid.Column="0" Spacing="4">
                            <Label Text="VEHICLE REGISTRATION"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="Complete all required fields to register"
                                   FontSize="11" TextColor="#AAFFCC"/>
                        </StackLayout>
                        <yummy:PancakeView Grid.Column="1"
                                           BackgroundColor="Transparent"
                                           CornerRadius="16"
                                           Padding="14,10"
                                           VerticalOptions="Center">
                            <Image Source="logo" HeightRequest="50"/>
                        </yummy:PancakeView>
                    </Grid>
                </yummy:PancakeView>

                <!-- ══════════ NOTICE BANNER ══════════ -->
                <yummy:PancakeView Margin="16,20,16,0"
                                   BackgroundColor="#FFAA4415"
                                   CornerRadius="12"
                                   Padding="14,10"
                                   BorderColor="#FFAA4440" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="⚠️" FontSize="16"
                               VerticalOptions="Center" Margin="0,0,10,0"/>
                        <Label Grid.Column="1"
                               Text="Fields marked with * are required. Please fill all mandatory fields before submitting."
                               FontSize="11" TextColor="#FFCC88"
                               LineBreakMode="WordWrap"/>
                    </Grid>
                </yummy:PancakeView>

                <!-- ══════════ FORM CARD ══════════ -->
                <yummy:PancakeView Margin="16,14,16,30"
                                   Padding="20,24,20,24"
                                   BackgroundColor="White"
                                   CornerRadius="24"
                                   Elevation="12" HasShadow="True"
                                   BorderColor="White" BorderThickness="1">
                    <StackLayout Spacing="20">

                        <!-- DRIVER NAME -->
                        <StackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="NAME OF DRIVER"
                                       FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="1.5" TextColor="#004225"/>
                                <Label Grid.Column="1" Text="Required *"
                                       FontSize="9" TextColor="#FF6B6B"/>
                            </Grid>
                            <yummy:PancakeView BackgroundColor="#004225"
                                               CornerRadius="12"
                                               HeightRequest="52"
                                               Padding="14,0,0,0"
                                               BorderColor="#4DA6FF30" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="+" TextColor="White"
                                           FontSize="16" VerticalOptions="Center"
                                           Margin="0,0,10,0"/>
                                    <renderers1:BorderlessEntry
                                        Grid.Column="1"
                                        x:Name="drivername"
                                        FontSize="13"
                                        Keyboard="Text"
                                        ClearButtonVisibility="WhileEditing"
                                        Placeholder="Full name of driver"
                                        PlaceholderColor="White"
                                        TextColor="White"
                                        BackgroundColor="Transparent"/>
                                </Grid>
                            </yummy:PancakeView>
                        </StackLayout>

                        <!-- PLATE NUMBER -->
                        <StackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="PLATE NUMBER"
                                       FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="1.5" TextColor="#004225"/>
                                <Label Grid.Column="1" Text="Required *"
                                       FontSize="9" TextColor="#FF6B6B"/>
                            </Grid>
                            <yummy:PancakeView BackgroundColor="#004225"
                                               CornerRadius="12"
                                               HeightRequest="52"
                                               Padding="14,0,0,0"
                                               BorderColor="#004225" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="+" TextColor="White"
                                           FontSize="16" VerticalOptions="Center"
                                           Margin="0,0,10,0"/>
                                    <renderers1:BorderlessEntry
                                        Grid.Column="1"
                                        x:Name="Platenumber"
                                        FontSize="14" FontAttributes="Bold"
                                        Keyboard="Text"
                                        ClearButtonVisibility="WhileEditing"
                                        Placeholder="e.g. ABC-123-XY"
                                        PlaceholderColor="White"
                                        TextColor="White"
                                        BackgroundColor="Transparent"/>
                                </Grid>
                            </yummy:PancakeView>
                        </StackLayout>

                        <!-- OWNER PHONE -->
                        <StackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="OWNER PHONE NUMBER"
                                       FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="1.5" TextColor="#004225"/>
                                <Label Grid.Column="1" Text="Required *"
                                       FontSize="9" TextColor="#FF6B6B"/>
                            </Grid>
                            <yummy:PancakeView BackgroundColor="#004225"
                                               CornerRadius="12"
                                               HeightRequest="52"
                                               Padding="14,0,0,0"
                                               BorderColor="#004225" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="+ " TextColor="White"
                                           FontSize="16" VerticalOptions="Center"
                                           Margin="0,0,10,0"/>
                                    <renderers1:BorderlessEntry
                                        Grid.Column="1"
                                        x:Name="Ownernumber"
                                        FontSize="13"
                                        Keyboard="Telephone"
                                        MaxLength="11"
                                        ClearButtonVisibility="WhileEditing"
                                        Placeholder="e.g. 08012345678"
                                        PlaceholderColor="White"
                                        TextColor="White"
                                        BackgroundColor="Transparent"/>
                                </Grid>
                            </yummy:PancakeView>
                        </StackLayout>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" BackgroundColor="#004225"/>

                        <!-- VEHICLE CATEGORY -->
                        <StackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="VEHICLE CATEGORY"
                                       FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="1.5" TextColor="#004225"/>
                                <Label Grid.Column="1" Text="Required *"
                                       FontSize="9" TextColor="#FF6B6B"/>
                            </Grid>
                            <yummy:PancakeView BackgroundColor="#004225"
                                               CornerRadius="12"
                                               HeightRequest="52"
                                               Padding="14,0,0,0"
                                               BorderColor="#004225" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="+ " TextColor="White"
                                           FontSize="16" VerticalOptions="Center"
                                           Margin="0,0,10,0"/>
                                    <Picker Grid.Column="1"
                                            x:Name="picker"
                                            Title="Select vehicle category"
                                            TitleColor="White"
                                            TextColor="#004225"
                                            FontSize="12"/>
                                </Grid>
                            </yummy:PancakeView>
                        </StackLayout>

                        <!-- LGA -->
                        <StackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="LOCAL GOVERNMENT AREA"
                                       FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="1.5" TextColor="#004225"/>
                                <Label Grid.Column="1" Text="Required *"
                                       FontSize="9" TextColor="#FF6B6B"/>
                            </Grid>
                            <yummy:PancakeView BackgroundColor="#004225"
                                               CornerRadius="12"
                                               HeightRequest="52"
                                               Padding="14,0,0,0"
                                               BorderColor="#004225" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="+ " TextColor="White"
                                           FontSize="16" VerticalOptions="Center"
                                           Margin="0,0,10,0"/>
                                    <Picker Grid.Column="1"
                                            x:Name="picker2"
                                            Title="Select LGA"
                                            TitleColor="White"
                                            TextColor="#004225"
                                            FontSize="12"/>
                                </Grid>
                            </yummy:PancakeView>
                        </StackLayout>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" BackgroundColor="#004225"/>

                        <!-- SUBMIT button -->
                        <yummy:PancakeView BackgroundGradientStartColor="#004225"
                                           BackgroundGradientEndColor="#00AA55"
                                           BackgroundGradientAngle="90"
                                           CornerRadius="16"
                                           HeightRequest="58"
                                           Elevation="8"
                                           BorderColor="#00FF8840" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0" Text="+ " FontSize="22" TextColor="White"
                                       VerticalOptions="Center" Margin="18,0,0,0"/>
                                <Label Grid.Column="1"
                                       Text="REGISTER VEHICLE"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="→" FontSize="18"
                                       TextColor="White"
                                       VerticalOptions="Center" Margin="0,0,18,0"/>
                            </Grid>
                            <yummy:PancakeView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                            </yummy:PancakeView.GestureRecognizers>
                        </yummy:PancakeView>

                    </StackLayout>
                </yummy:PancakeView>

            </StackLayout>
        </ScrollView>

        <!-- ══════════ SUCCESS OVERLAY POPUP ══════════ -->
        <dxui:ModalityLayout.Behaviors>
            <dxui:SheetBehavior x:Name="sheetBehavior"
                                IsOpen="False"
                                IsCancelButtonVisible="False"
                                TitleColor="#004225"
                                ActionTitle="CLOSE"
                                ActionTitleColor="#004225"
                                ActionClicked="sheetBehavior_ActionClicked"
                                Title="REGISTRATION STATUS"
                                HeaderColor="White"
                                TitleFontAttributes="Bold"
                                IsDraggable="True"
                                VerticalContentAlignment="SameAsSheet">
                <dxui:SheetBehavior.SheetContentTemplate>
                    <DataTemplate>
                        <StackLayout Spacing="20"
                                     HorizontalOptions="CenterAndExpand"
                                     VerticalOptions="FillAndExpand"
                                     Padding="24,10,24,30"
                                     BackgroundColor="#0A1628">

                            <!-- Success icon -->
                            <yummy:PancakeView BackgroundColor="#00FF8818"
                                               CornerRadius="50"
                                               WidthRequest="90" HeightRequest="90"
                                               HorizontalOptions="Center"
                                               BorderColor="#00FF8860" BorderThickness="2"
                                               Margin="0,10,0,0">
                                <Label Text="✅" FontSize="44"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </yummy:PancakeView>

                            <Label Text="REGISTRATION SUCCESSFUL"
                                   FontSize="18" FontAttributes="Bold"
                                   TextColor="#00FF88"
                                   HorizontalOptions="Center"
                                   CharacterSpacing="1"/>

                            <Label Text="The vehicle has been successfully registered&#x0a;in the Gurara LGA Haulage system."
                                   FontSize="12" TextColor="#667788"
                                   HorizontalTextAlignment="Center"/>

                            <yummy:PancakeView BackgroundGradientStartColor="#004225"
                                               BackgroundGradientEndColor="#00AA55"
                                               BackgroundGradientAngle="90"
                                               CornerRadius="14"
                                               HeightRequest="52">
                                <Label Text="REGISTER ANOTHER  →"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="tryagain_Clicked"/>
                                </yummy:PancakeView.GestureRecognizers>
                            </yummy:PancakeView>

                        </StackLayout>
                    </DataTemplate>
                </dxui:SheetBehavior.SheetContentTemplate>
            </dxui:SheetBehavior>

            <!-- ══════════ FAILURE OVERLAY POPUP ══════════ -->
            <dxui:SheetBehavior x:Name="failedenumeration"
                                IsOpen="False"
                                IsCancelButtonVisible="False"
                                TitleColor="#FF4A4A"
                                ActionTitle="CLOSE"
                                ActionTitleColor="#FF4A4A"
                                ActionClicked="failedenumeration_ActionClicked"
                                Title="REGISTRATION FAILED"
                                HeaderColor="White"
                                TitleFontAttributes="Bold"
                                IsDraggable="True"
                                VerticalContentAlignment="SameAsSheet">
                <dxui:SheetBehavior.SheetContentTemplate>
                    <DataTemplate>
                        <StackLayout Spacing="20"
                                     HorizontalOptions="CenterAndExpand"
                                     VerticalOptions="FillAndExpand"
                                     Padding="24,10,24,30"
                                     BackgroundColor="#0A1628">

                            <yummy:PancakeView BackgroundColor="#FF4A4A18"
                                               CornerRadius="50"
                                               WidthRequest="90" HeightRequest="90"
                                               HorizontalOptions="Center"
                                               BorderColor="#FF4A4A60" BorderThickness="2"
                                               Margin="0,10,0,0">
                                <Label Text="❌" FontSize="44"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </yummy:PancakeView>

                            <Label Text="REGISTRATION FAILED"
                                   FontSize="18" FontAttributes="Bold"
                                   TextColor="#FF4A4A"
                                   HorizontalOptions="Center"
                                   CharacterSpacing="1"/>

                            <Label Text="The registration could not be completed.&#x0a;Please verify your details and try again."
                                   FontSize="12" TextColor="#667788"
                                   HorizontalTextAlignment="Center"/>

                            <yummy:PancakeView BackgroundColor="#3A1010"
                                               CornerRadius="14"
                                               HeightRequest="52"
                                               BorderColor="#FF4A4A60" BorderThickness="1">
                                <Label Text="TRY AGAIN"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="#FF6666"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="tryagain_Clicked"/>
                                </yummy:PancakeView.GestureRecognizers>
                            </yummy:PancakeView>

                        </StackLayout>
                    </DataTemplate>
                </dxui:SheetBehavior.SheetContentTemplate>
            </dxui:SheetBehavior>

        </dxui:ModalityLayout.Behaviors>

    </dxui:ModalityLayout>
</ContentPage>
