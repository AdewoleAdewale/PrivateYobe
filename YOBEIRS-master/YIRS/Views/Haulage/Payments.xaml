<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:dxui="http://dips.xamarin.ui.com" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:renderers11="clr-namespace:YIRS.Renderers"
             x:Class="YIRS.Views.Haulage.Payments"             NavigationPage.HasNavigationBar="True"
             BackgroundColor="#F2F6F3"
             Padding="0">

    <dxui:ModalityLayout OverlayColor="Transparent" Opacity="10">

        <Grid>

            <!-- ══════════════════════════════════════════════
                 MAIN SCROLLABLE CONTENT
            ══════════════════════════════════════════════ -->
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <StackLayout Spacing="0">

                    <!-- Gradient Header Banner -->
                    <yummy:PancakeView BackgroundGradientStartColor="#004225"
                                       BackgroundGradientEndColor="#006B3C"
                                       BackgroundGradientAngle="135"
                                       CornerRadius="0,0,30,30"
                                       Padding="20,50,20,30">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackLayout Grid.Column="0" Spacing="4">
                                <Label Text="HAULAGE PAYMENT"
                                       FontSize="24" FontAttributes="Bold"
                                       TextColor="White"/>
                                <Label Text="Complete your transaction below"
                                       FontSize="12" TextColor="White"/>
                            </StackLayout>
                            <yummy:PancakeView Grid.Column="1"
                                               BackgroundColor="#F2F6F3"
                                               CornerRadius="16"
                                               Padding="12,8"
                                               VerticalOptions="Center">
                                <Image Source="Logo" HeightRequest="30" ></Image>
                            </yummy:PancakeView>
                        </Grid>
                    </yummy:PancakeView>

                    <!-- Form Card -->
                    <yummy:PancakeView Margin="16,-16,16,0"
                                       Padding="20,24,20,24"
                                       BackgroundColor="#F2F6F3"
                                       CornerRadius="24"
                                       Elevation="12" HasShadow="True"
                                       BorderColor="Transparent" BorderThickness="1">
                        <StackLayout Spacing="18">

                            <!-- SERVICE NAME -->
                            <StackLayout Spacing="6">
                                <Label Text="SERVICE NAME"
                                       FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       TextColor="#004225"/>
                                <yummy:PancakeView BackgroundColor="#004225"
                                                   CornerRadius="12"
                                                   Padding="14,0,0,0"
                                                   HeightRequest="50"
                                                   BorderColor="#004225" BorderThickness="1">
                                    <renderers11:BorderlessEntry x:Name="Servicename"
                                                                 FontSize="13"
                                                                 IsReadOnly="True"
                                                                 TextColor="White"
                                                                 BackgroundColor="Transparent"/>
                                </yummy:PancakeView>
                            </StackLayout>

                            <!-- PLATE NUMBER -->
                            <StackLayout Spacing="6">
                                <Label Text="PLATE NUMBER"
                                       FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       TextColor="#004225"/>
                                <yummy:PancakeView BackgroundColor="#004225"
                                                   CornerRadius="12"
                                                   Padding="14,0,0,0"
                                                   HeightRequest="50"
                                                   BorderColor="#004225" BorderThickness="1">
                                    <renderers11:BorderlessEntry x:Name="PayerId"
                                                                 FontSize="13"
                                                                 IsReadOnly="True"
                                                                 TextColor="White"
                                                                 FontAttributes="Bold"
                                                                 BackgroundColor="Transparent"/>
                                </yummy:PancakeView>
                            </StackLayout>

                            <!-- LGA -->
                            <StackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="LGA TO"
                                           FontSize="10" FontAttributes="Bold"
                                           CharacterSpacing="1.5"
                                           TextColor="#004225"/>
                                    <Label Grid.Column="1"
                                           Text="Required *"
                                           FontSize="9" TextColor="#FF6B6B"/>
                                </Grid>
                                <yummy:PancakeView BackgroundColor="#004225"
                                                   CornerRadius="12"
                                                   Padding="14,0,0,0"
                                                   HeightRequest="50"
                                                   BorderColor="#004225" BorderThickness="1">
                                    <Picker x:Name="picker"
                                            Title="Select destination LGA"
                                            TitleColor="White"
                                            TextColor="#004225"
                                            FontSize="12"/>
                                </yummy:PancakeView>
                            </StackLayout>

                            <!-- AMOUNT -->
                            <StackLayout Spacing="6">
                                <Label Text="AMOUNT (₦)"
                                       FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       TextColor="#004225"/>
                                <yummy:PancakeView BackgroundColor="#004225"
                                                   CornerRadius="12"
                                                   Padding="14,0,0,0"
                                                   HeightRequest="50"
                                                   BorderColor="#004225" BorderThickness="1">
                                    <renderers11:BorderlessEntry x:Name="Amount"
                                                                 FontSize="16" FontAttributes="Bold"
                                                                 Keyboard="Numeric"
                                                                 TextColor="White"
                                                                 ClearButtonVisibility="WhileEditing"
                                                                 BackgroundColor="Transparent"/>
                                </yummy:PancakeView>
                            </StackLayout>

                            <!-- PIN -->
                            <StackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="TRANSACTION PIN"
                                           FontSize="10" FontAttributes="Bold"
                                           CharacterSpacing="1.5"
                                           TextColor="#004225"/>
                                    <Label Grid.Column="1"
                                           Text="4-digit PIN"
                                           FontSize="9" TextColor="#004225"/>
                                </Grid>
                                <yummy:PancakeView BackgroundColor="#004225"
                                                   CornerRadius="12"
                                                   Padding="14,0,0,0"
                                                   HeightRequest="50"
                                                   BorderColor="#004225" BorderThickness="1">
                                    <renderers11:BorderlessEntry x:Name="PIN"
                                                                 FontSize="20"
                                                                 IsPassword="True"
                                                                 MaxLength="4"
                                                                 Keyboard="Numeric"
                                                                 Placeholder="● ● ● ●"
                                                                 PlaceholderColor="White"
                                                                 Unfocused="Pin_Unfocused"
                                                                 TextColor="White"
                                                                 BackgroundColor="Transparent"/>
                                </yummy:PancakeView>
                            </StackLayout>

                            <!-- Divider -->
                            <BoxView HeightRequest="1" BackgroundColor="#004225" Margin="0,4"/>

                            <!-- PROCESS PAYMENT button -->
                            <yummy:PancakeView x:Name="makepaymentbutton"
                                               IsVisible="False"
                                               BackgroundGradientStartColor="#004225"
                                               BackgroundGradientEndColor="#00AA55"
                                               BackgroundGradientAngle="90"
                                               CornerRadius="16"
                                               Elevation="8" HasShadow="True"
                                               HeightRequest="58"
                                               BorderColor="#00FF8840" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Label Grid.Column="0" Text="+ " FontSize="20" TextColor="White"
                                           VerticalOptions="Center" Margin="16,0,0,0"/>
                                    <Label Grid.Column="1"
                                           Text="PROCESS PAYMENT"
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="→" FontSize="18"
                                           TextColor="#AAFFCC"
                                           VerticalOptions="Center" Margin="0,0,16,0"/>
                                </Grid>
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                                </yummy:PancakeView.GestureRecognizers>
                            </yummy:PancakeView>

                            <!-- REPRINT button -->
                            <yummy:PancakeView x:Name="ReprintButtonView"
                                               IsVisible="False"
                                               BackgroundColor="#1A2B1A"
                                               CornerRadius="16"
                                               HeightRequest="50"
                                               BorderColor="#004225" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="🖨️" FontSize="18"
                                           VerticalOptions="Center" Margin="16,0,0,0"/>
                                    <Button x:Name="ReprintButton"
                                            Grid.Column="1"
                                            Text="REPRINT RECEIPT"
                                            Clicked="OnReprintClicked"
                                            BackgroundColor="Transparent"
                                            TextColor="#FFAA44"
                                            FontAttributes="Bold"
                                            FontSize="13"/>
                                </Grid>
                            </yummy:PancakeView>

                        </StackLayout>
                    </yummy:PancakeView>

                    <!-- Security note -->
                    <StackLayout Orientation="Horizontal" Margin="24,16,24,30"
                                 Spacing="8" HorizontalOptions="Center">
                        <Label Text="🔒" FontSize="12" VerticalOptions="Center"/>
                        <Label Text="Secured by 256-bit TLS encryption"
                               FontSize="10" TextColor="#445566"
                               VerticalOptions="Center"/>
                    </StackLayout>

                </StackLayout>
            </ScrollView>

            <!-- ══════════════════════════════════════════════
                 LOADING OVERLAY
            ══════════════════════════════════════════════ -->
            <Grid x:Name="LoadingOverlay"
                  IsVisible="False"
                  BackgroundColor="#CC060E1A">
                <yummy:PancakeView BackgroundColor="#111E2E"
                                   CornerRadius="24"
                                   Padding="36,28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   WidthRequest="240"
                                   BorderColor="#004225" BorderThickness="1">
                    <StackLayout Spacing="18" HorizontalOptions="Center">
                        <ActivityIndicator IsRunning="True"
                                           Color="#00FF88"
                                           HeightRequest="48" WidthRequest="48"
                                           HorizontalOptions="Center"/>
                        <Label Text="Processing Payment…"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"/>
                        <Label Text="Please do not close the app"
                               FontSize="10" TextColor="#667788"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </yummy:PancakeView>
            </Grid>

            <!-- ══════════════════════════════════════════════
                 SUCCESS POPUP OVERLAY
            ══════════════════════════════════════════════ -->
            <Grid x:Name="SuccessOverlay"
                  IsVisible="False"
                  BackgroundColor="#EE060E1A">
                <yummy:PancakeView BackgroundGradientStartColor="#0D2A1A"
                                   BackgroundGradientEndColor="#111E2E"
                                   BackgroundGradientAngle="135"
                                   CornerRadius="28"
                                   Padding="28"
                                   HorizontalOptions="FillAndExpand"
                                   VerticalOptions="Center"
                                   Margin="20"
                                   BorderColor="#00FF8840" BorderThickness="1"
                                   Elevation="20">
                    <StackLayout Spacing="16" HorizontalOptions="Center">

                        <!-- Success icon -->
                        <yummy:PancakeView BackgroundColor="#00FF8818"
                                           CornerRadius="40"
                                           WidthRequest="80" HeightRequest="80"
                                           HorizontalOptions="Center"
                                           BorderColor="#00FF8860" BorderThickness="2">
                            <Label Text="✅" FontSize="40"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </yummy:PancakeView>

                        <Label Text="PAYMENT SUCCESSFUL"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="#00FF88"
                               HorizontalOptions="Center"
                               CharacterSpacing="1"/>

                        <!-- Receipt details box -->
                        <yummy:PancakeView BackgroundColor="#0D1825"
                                           CornerRadius="16"
                                           Padding="16"
                                           BorderColor="#004225" BorderThickness="1">
                            <StackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,*">
                                    <Label Grid.Column="0" Text="Reference"
                                           FontSize="11" TextColor="#667788"/>
                                    <Label x:Name="PopupRef"
                                           Grid.Column="1" FontSize="11"
                                           FontAttributes="Bold" TextColor="White"
                                           HorizontalTextAlignment="End"/>
                                </Grid>
                                <BoxView HeightRequest="1" BackgroundColor="#004225"/>
                                <Grid ColumnDefinitions="*,*">
                                    <Label Grid.Column="0" Text="Vehicle Type"
                                           FontSize="11" TextColor="#667788"/>
                                    <Label x:Name="PopupVehicle"
                                           Grid.Column="1" FontSize="11"
                                           TextColor="White"
                                           HorizontalTextAlignment="End"/>
                                </Grid>
                                <BoxView HeightRequest="1" BackgroundColor="#004225"/>
                                <Grid ColumnDefinitions="*,*">
                                    <Label Grid.Column="0" Text="Plate Number"
                                           FontSize="11" TextColor="#667788"/>
                                    <Label x:Name="PopupPlate"
                                           Grid.Column="1" FontSize="11"
                                           TextColor="#4DA6FF" FontAttributes="Bold"
                                           HorizontalTextAlignment="End"/>
                                </Grid>
                                <BoxView HeightRequest="1" BackgroundColor="#004225"/>
                                <Grid ColumnDefinitions="*,*">
                                    <Label Grid.Column="0" Text="LGA To"
                                           FontSize="11" TextColor="#667788"/>
                                    <Label x:Name="PopupLGA"
                                           Grid.Column="1" FontSize="11"
                                           TextColor="White"
                                           HorizontalTextAlignment="End"/>
                                </Grid>
                                <BoxView HeightRequest="1" BackgroundColor="#004225"/>
                                <Grid ColumnDefinitions="*,*">
                                    <Label Grid.Column="0" Text="Amount Paid"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="#AAFFCC"/>
                                    <Label x:Name="PopupAmount"
                                           Grid.Column="1" FontSize="16"
                                           FontAttributes="Bold" TextColor="#00FF88"
                                           HorizontalTextAlignment="End"/>
                                </Grid>
                            </StackLayout>
                        </yummy:PancakeView>

                        <!-- Printing status label -->
                        <Label x:Name="PrintingStatusLabel"
                               Text="🖨️  Sending to printer…"
                               FontSize="11" TextColor="#AAFFCC"
                               HorizontalOptions="Center"/>

                        <!-- Continue button -->
                        <yummy:PancakeView BackgroundGradientStartColor="#004225"
                                           BackgroundGradientEndColor="#00AA55"
                                           BackgroundGradientAngle="90"
                                           CornerRadius="14"
                                           HeightRequest="50">
                            <Label Text="CONTINUE  →"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <yummy:PancakeView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="SuccessContinue_Tapped"/>
                            </yummy:PancakeView.GestureRecognizers>
                        </yummy:PancakeView>

                    </StackLayout>
                </yummy:PancakeView>
            </Grid>

            <!-- ══════════════════════════════════════════════
                 FAILURE POPUP OVERLAY
            ══════════════════════════════════════════════ -->
            <Grid x:Name="FailureOverlay"
                  IsVisible="False"
                  BackgroundColor="#EE060E1A">
                <yummy:PancakeView BackgroundGradientStartColor="#2A0D0D"
                                   BackgroundGradientEndColor="#111E2E"
                                   BackgroundGradientAngle="135"
                                   CornerRadius="28"
                                   Padding="28"
                                   HorizontalOptions="FillAndExpand"
                                   VerticalOptions="Center"
                                   Margin="20"
                                   BorderColor="#FF4A4A40" BorderThickness="1"
                                   Elevation="20">
                    <StackLayout Spacing="16" HorizontalOptions="Center">

                        <!-- Failure icon -->
                        <yummy:PancakeView BackgroundColor="#FF4A4A18"
                                           CornerRadius="40"
                                           WidthRequest="80" HeightRequest="80"
                                           HorizontalOptions="Center"
                                           BorderColor="#FF4A4A60" BorderThickness="2">
                            <Label Text="❌" FontSize="40"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </yummy:PancakeView>

                        <Label Text="TRANSACTION FAILED"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="#FF4A4A"
                               HorizontalOptions="Center"
                               CharacterSpacing="1"/>

                        <yummy:PancakeView BackgroundColor="#0D1825"
                                           CornerRadius="16"
                                           Padding="16"
                                           BorderColor="#FF4A4A20" BorderThickness="1">
                            <StackLayout Spacing="8">
                                <Label Text="Reason" FontSize="11" TextColor="#667788"/>
                                <Label x:Name="FailureMessage"
                                       FontSize="13" TextColor="#FF8888"
                                       HorizontalTextAlignment="Center"/>
                            </StackLayout>
                        </yummy:PancakeView>

                        <Label Text="Please verify your details and try again,&#x0a;or check your History if deducted."
                               FontSize="10" TextColor="#556677"
                               HorizontalTextAlignment="Center"/>

                        <!-- Retry button -->
                        <yummy:PancakeView BackgroundColor="#3A1010"
                                           CornerRadius="14"
                                           HeightRequest="50"
                                           BorderColor="#FF4A4A60" BorderThickness="1">
                            <Label Text="TRY AGAIN"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="#FF6666"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <yummy:PancakeView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="FailureRetry_Tapped"/>
                            </yummy:PancakeView.GestureRecognizers>
                        </yummy:PancakeView>

                    </StackLayout>
                </yummy:PancakeView>
            </Grid>

        </Grid>

        <!-- ══════════════════════════════════════════════
             SUCCESS SHEET (legacy, kept as fallback)
        ══════════════════════════════════════════════ -->
        <dxui:ModalityLayout.Behaviors>
            <dxui:SheetBehavior x:Name="sheetBehavior"
                                IsOpen="False"
                                IsCancelButtonVisible="True"
                                TitleColor="#004225"
                                CancelTitle="CLOSE"
                                CancelTitleColor="Red"
                                ActionTitle="CLOSE"
                                ActionClicked="sheetBehavior_ActionClicked"
                                Title="NOTIFICATION"
                                HeaderColor="White"
                                TitleFontAttributes="Bold"
                                IsDraggable="True"
                                VerticalContentAlignment="SameAsSheet">
                <dxui:SheetBehavior.SheetContentTemplate>
                    <DataTemplate>
                        <StackLayout HorizontalOptions="CenterAndExpand"
                                     VerticalOptions="FillAndExpand"
                                     Padding="20" Spacing="16">
                            <Image Source="gooddone" Aspect="AspectFit"
                                   HeightRequest="80" IsAnimationPlaying="True"/>
                            <Label Text="PAYMENT SUCCESSFUL"
                                   TextColor="#004225"
                                   HorizontalTextAlignment="Center"
                                   FontSize="20" FontAttributes="Bold"/>
                            <Button BackgroundColor="#004225"
                                    Text="CONTINUE"
                                    CornerRadius="10"
                                    Clicked="Button_Clicked"
                                    TextColor="White"
                                    HorizontalOptions="FillAndExpand"/>
                        </StackLayout>
                    </DataTemplate>
                </dxui:SheetBehavior.SheetContentTemplate>
            </dxui:SheetBehavior>
        </dxui:ModalityLayout.Behaviors>

    </dxui:ModalityLayout>
</ContentPage>
