<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:renderers="clr-namespace:YIRS.Renderers"
             x:Class="YIRS.Views.Home.Gazette"    
             Padding="0,20,0,0"
    BackgroundColor="#004225"
    NavigationPage.HasNavigationBar="True">


    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">


        <StackLayout>
            <Grid Margin="0,0,0,0">
                <StackLayout Margin="20,0,20,0" Spacing="20">

                    <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="CONFIRM TRANSACTION"
                    TextColor="White"
                    VerticalOptions="CenterAndExpand" />
                </StackLayout>

            </Grid>
            <yummy:PancakeView
                Margin="0,30,0,0"
                Padding="30,0,30,30"
                BackgroundColor="White"
                CornerRadius="40,40,0,0"
                VerticalOptions="FillAndExpand">

                <StackLayout Spacing="10">



                    <yummy:PancakeView
                        Padding="10,0,0,0"
                        BackgroundColor="White"
                        BorderThickness="1"
                        CornerRadius="15"
                        Elevation="3"                            
                        HeightRequest="50">
                        <renderers:BorderlessEntry
                            FontSize="15"
                            ClearButtonVisibility="WhileEditing"
                            Keyboard="Email"
                            x:Name="Search" Placeholder="Input Transaction Number"
                               
                            TextColor="#484848"
                               />
                    </yummy:PancakeView>


                    <Button                     
                    Text="GET TRANSACTION INFO"
                        FontAttributes="Bold"
                        CornerRadius="20"
                    BackgroundColor="#004225" TextColor="White" Clicked="Button_Clicked"
                    />





                </StackLayout>

            </yummy:PancakeView>
        </StackLayout>
    </ScrollView>
</ContentPage>