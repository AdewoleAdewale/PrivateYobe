<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" 
             xmlns:renderers11="clr-namespace:YIRS.Renderers"
             x:Class="YIRS.Views.Home.DirectPayment"    
             NavigationPage.HasNavigationBar="True"
             BackgroundColor="#004225"
             Padding="0,20,0,0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="LabelHeaderStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#6B7280"/>
                <Setter Property="Margin" Value="5,0,0,0"/>
            </Style>

            <Style x:Key="InputContainerStyle" TargetType="yummy:PancakeView">
                <Setter Property="Padding" Value="15,0,15,0"/>
                <Setter Property="BackgroundColor" Value="#F9FAFB"/>
                <Setter Property="BorderColor" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HeightRequest" Value="55"/>
            </Style>

            <Style x:Key="InputStyle" TargetType="renderers11:BorderlessEntry">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextColor" Value="#111827"/>
                <Setter Property="PlaceholderColor" Value="#9CA3AF"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <StackLayout>
            <!-- Header Section -->
            <StackLayout Margin="0,0,0,0" Orientation="Horizontal">
                <StackLayout Margin="25,15,25,0" Spacing="8">
                    <Label
                        FontAttributes="Bold"
                        FontSize="26"
                        Text="Direct Payment"
                        TextColor="White"
                        VerticalOptions="CenterAndExpand" />
                    <Label
                        FontSize="14"
                        Text="Complete your transaction securely"
                        TextColor="#A7F3D0"
                        VerticalOptions="CenterAndExpand" />
                </StackLayout>
            </StackLayout>

            <!-- Main Content Card -->
            <yummy:PancakeView
                Margin="0,30,0,0"
                Padding="25,40,25,40"
                BackgroundColor="White"
                CornerRadius="30,30,0,0"
                VerticalOptions="FillAndExpand"
                Elevation="8">
                <StackLayout Spacing="25">

                    <!-- Business Information Section -->
                    <StackLayout Spacing="20">
                        <Label
                            FontSize="18"
                            FontAttributes="Bold"
                            Text="Business Information"
                            TextColor="#111827"
                            Margin="0,0,0,5"/>

                        <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,0,0,10"/>

                        <!-- Business Name -->
                        <StackLayout Spacing="8">
                            <Label Text="Business Name" Style="{StaticResource LabelHeaderStyle}" />
                            <yummy:PancakeView Style="{StaticResource InputContainerStyle}">
                                <renderers11:BorderlessEntry
                                    Style="{StaticResource InputStyle}"
                                    IsEnabled="False"
                                    x:Name="BusinessName"/>
                            </yummy:PancakeView>
                        </StackLayout>

                        <!-- LGA -->
                        <StackLayout Spacing="8">
                            <Label Text="Local Government Area" Style="{StaticResource LabelHeaderStyle}" />
                            <yummy:PancakeView Style="{StaticResource InputContainerStyle}">
                                <renderers11:BorderlessEntry
                                    Style="{StaticResource InputStyle}"
                                    IsEnabled="False"
                                    x:Name="LGA"/>
                            </yummy:PancakeView>
                        </StackLayout>
                    </StackLayout>

                    <!-- Payment Details Section -->
                    <StackLayout Spacing="20">
                        <Label
                            FontSize="18"
                            FontAttributes="Bold"
                            Text="Payment Details"
                            TextColor="#111827"
                            Margin="0,10,0,5"/>

                        <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,0,0,10"/>

                        <!-- Service Name -->
                        <StackLayout Spacing="8">
                            <Label Text="Service Name" Style="{StaticResource LabelHeaderStyle}" />
                            <yummy:PancakeView Style="{StaticResource InputContainerStyle}">
                                <renderers11:BorderlessEntry
                                    Style="{StaticResource InputStyle}"
                                    IsEnabled="False"
                                    x:Name="ServiceName"/>
                            </yummy:PancakeView>
                        </StackLayout>

                        <!-- Amount -->
                        <StackLayout Spacing="8">
                            <Label Text="Service Amount (₦)" Style="{StaticResource LabelHeaderStyle}" />
                            <yummy:PancakeView 
                                Padding="15,0,15,0"
                                BackgroundColor="White"
                                BorderColor="#10B981"
                                BorderThickness="2"
                                CornerRadius="12"
                                HeightRequest="55">
                                <renderers11:BorderlessEntry
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    ClearButtonVisibility="WhileEditing"
                                    Keyboard="Numeric"
                                    TextColor="#059669"
                                    x:Name="Amount"/>
                            </yummy:PancakeView>
                        </StackLayout>
                    </StackLayout>

                    <!-- Security Section -->
                    <StackLayout Spacing="20">
                        <Label
                            FontSize="18"
                            FontAttributes="Bold"
                            Text="Security"
                            TextColor="#111827"
                            Margin="0,10,0,5"/>

                        <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,0,0,10"/>

                        <!-- PIN -->
                        <StackLayout Spacing="8">
                            <StackLayout Orientation="Horizontal" Spacing="5">
                                <Label Text="Transaction PIN" Style="{StaticResource LabelHeaderStyle}" />
                                <Label Text="(4 digits)" FontSize="12" TextColor="#9CA3AF" VerticalOptions="Center"/>
                            </StackLayout>
                            <yummy:PancakeView Style="{StaticResource InputContainerStyle}">
                                <renderers11:BorderlessEntry
                                    Style="{StaticResource InputStyle}"
                                    Placeholder="Enter 4-digit PIN"
                                    ClearButtonVisibility="WhileEditing"
                                    IsPassword="True"  
                                    Keyboard="Numeric"
                                    MaxLength="4"
                                    x:Name="PIN"/>
                            </yummy:PancakeView>
                        </StackLayout>
                    </StackLayout>

                    <!-- Payment Button -->
                    <yummy:PancakeView
                        BackgroundColor="#004225"
                        CornerRadius="14"
                        HasShadow="True"
                        Elevation="5"
                        HeightRequest="58"
                        HorizontalOptions="FillAndExpand"
                        Margin="0,20,0,0">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalOptions="CenterAndExpand"
                            Text="PROCESS PAYMENT"
                            TextColor="White"
                            VerticalOptions="CenterAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </yummy:PancakeView>

                    <StackLayout x:Name="MessageContainer" IsVisible="False">
                        <Frame x:Name="MessageFrame"
CornerRadius="12"
HasShadow="True"
Padding="15"
Margin="0,5">
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label x:Name="MessageIcon"
        FontSize="18"
        VerticalOptions="Center" />
                                <Label x:Name="MessageLabel"
        FontSize="14"
        VerticalOptions="Center"
        HorizontalOptions="FillAndExpand"
        LineBreakMode="WordWrap" />
                            </StackLayout>
                        </Frame>
                    </StackLayout>


                    <!-- Security Notice -->
                    <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
                        <Label Text="🔒" FontSize="16" VerticalOptions="Center"/>
                        <Label
                            FontSize="12"
                            TextColor="#6B7280"
                            VerticalOptions="Center"
                            LineBreakMode="WordWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Your payment is secured with end-to-end encryption"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </StackLayout>

                </StackLayout>
            </yummy:PancakeView>
        </StackLayout>
    </ScrollView>
</ContentPage>