<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="YIRS.Views.Home.History"     
             Padding="0"
             BackgroundColor="#004225"
             NavigationPage.HasNavigationBar="True">

    <Grid>
        <!-- Main Content -->
        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <StackLayout>
                <!-- Header Section -->
                <Grid Padding="20,20,20,15" RowDefinitions="Auto,Auto">
                    <Label Grid.Row="0" 
                           Text="PAYMENT HISTORY" 
                           TextColor="White" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           HorizontalTextAlignment="Center"/>
                    <Label Grid.Row="1" 
                           Text="View your transaction records" 
                           TextColor="#B8E6D5" 
                           FontSize="14" 
                           HorizontalTextAlignment="Center"
                           Margin="0,5,0,0"/>
                </Grid>

                <!-- Main Content Card -->
                <yummy:PancakeView
                    Margin="0,10,0,0"
                    Padding="0"
                    BackgroundColor="White"
                    CornerRadius="30,30,0,0"
                    VerticalOptions="FillAndExpand"
                    HasShadow="True"
                    Elevation="10">

                    <StackLayout Spacing="0">
                        <!-- Filter Section -->
                        <yummy:PancakeView 
                            BackgroundColor="#F8F9FA"
                            Margin="20,25,20,20"
                            Padding="20,20"
                            CornerRadius="15"
                            HasShadow="True"
                            Elevation="3">

                            <StackLayout Spacing="15">
                                <Label Text="FILTER TRANSACTIONS" 
                                       FontFamily="OpenSans" 
                                       TextColor="#004225"  
                                       FontAttributes="Bold" 
                                       FontSize="16"
                                       HorizontalTextAlignment="Center"/>

                                <BoxView HeightRequest="1" 
                                         BackgroundColor="#E0E0E0" 
                                         Margin="0,0,0,10"/>

                                <!-- Start Date -->
                                <StackLayout Spacing="8">
                                    <Label Text="Start Date"   
                                           FontFamily="OpenSans" 
                                           TextColor="#004225"  
                                           FontAttributes="Bold" 
                                           FontSize="14"/>
                                    <yummy:PancakeView 
                                        BackgroundColor="White"
                                        CornerRadius="10"
                                        Padding="10,5"
                                        HasShadow="True"
                                        Elevation="2">
                                        <DatePicker x:Name="startDatePicker" 
                                                    MaximumDate="12/31/2029" 
                                                    FontSize="14"  
                                                    Format="MMMM dd, yyyy"
                                                    TextColor="#333333"/>
                                    </yummy:PancakeView>
                                </StackLayout>

                                <!-- End Date -->
                                <StackLayout Spacing="8">
                                    <Label Text="End Date"    
                                           FontFamily="OpenSans" 
                                           TextColor="#004225" 
                                           FontAttributes="Bold" 
                                           FontSize="14"/>
                                    <yummy:PancakeView 
                                        BackgroundColor="White"
                                        CornerRadius="10"
                                        Padding="10,5"
                                        HasShadow="True"
                                        Elevation="2">
                                        <DatePicker x:Name="endDatePicker" 
                                                    MinimumDate="01/01/2020" 
                                                    FontSize="14"   
                                                    Format="MMMM dd, yyyy"
                                                    TextColor="#333333"/>
                                    </yummy:PancakeView>
                                </StackLayout>

                                <!-- Search Button -->
                                <yummy:PancakeView 
                                    BackgroundColor="#004225"
                                    CornerRadius="12"
                                    HasShadow="True"
                                    Elevation="5"
                                    Margin="0,10,0,0">
                                    <Button Text="SEARCH TRANSACTIONS" 
                                            BackgroundColor="Transparent"
                                            TextColor="White" 
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            Clicked="Button_Clicked"
                                            HeightRequest="50"/>
                                </yummy:PancakeView>
                            </StackLayout>
                        </yummy:PancakeView>

                        <!-- ═══ Rich Transaction Summary Panel ═══ -->
                        <yummy:PancakeView x:Name="summarySection"
                                           IsVisible="False"
                                           CornerRadius="16"
                                           Elevation="5"
                                           Padding="0"
                                           Margin="20,0,20,18"
                                           BackgroundColor="White"
                                           BorderColor="#E5E7EB"
                                           BorderThickness="1">
                            <StackLayout Spacing="0">

                                <!-- Summary Header -->
                                <yummy:PancakeView CornerRadius="16,16,0,0" Padding="16,13">
                                    <yummy:PancakeView.BackgroundGradientStops>
                                        <yummy:GradientStopCollection>
                                            <yummy:GradientStop Color="#004225" Offset="0"/>
                                            <yummy:GradientStop Color="#006837" Offset="1"/>
                                        </yummy:GradientStopCollection>
                                    </yummy:PancakeView.BackgroundGradientStops>
                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                        <Label Text="📊" FontSize="16" VerticalOptions="Center"/>
                                        <Label Text="TRANSACTION SUMMARY"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               CharacterSpacing="1"
                                               VerticalOptions="Center"/>
                                    </StackLayout>
                                </yummy:PancakeView>

                                <!-- Three-column stats -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="0">

                                    <!-- Count -->
                                    <StackLayout Grid.Column="0" Padding="14,14" Spacing="3" HorizontalOptions="Center">
                                        <Label x:Name="summaryCountLabel"
                                               FontSize="24"
                                               FontAttributes="Bold"
                                               TextColor="#004225"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Text="Transactions"
                                               FontSize="11"
                                               TextColor="#6B7280"
                                               HorizontalTextAlignment="Center"/>
                                    </StackLayout>

                                    <BoxView Grid.Column="0"
                                             WidthRequest="1"
                                             BackgroundColor="#E5E7EB"
                                             HorizontalOptions="End"
                                             VerticalOptions="FillAndExpand"/>

                                    <!-- Total Amount -->
                                    <StackLayout Grid.Column="1" Padding="14,14" Spacing="3" HorizontalOptions="Center">
                                        <Label x:Name="summaryAmountLabel"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#D32F2F"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="Total Amount"
                                               FontSize="11"
                                               TextColor="#6B7280"
                                               HorizontalTextAlignment="Center"/>
                                    </StackLayout>

                                    <BoxView Grid.Column="1"
                                             WidthRequest="1"
                                             BackgroundColor="#E5E7EB"
                                             HorizontalOptions="End"
                                             VerticalOptions="FillAndExpand"/>

                                    <!-- Date Range -->
                                    <StackLayout Grid.Column="2" Padding="14,14" Spacing="3" HorizontalOptions="Center">
                                        <Label x:Name="summaryRangeLabel"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#004225"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap"/>
                                        <Label Text="Date Range"
                                               FontSize="11"
                                               TextColor="#6B7280"
                                               HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                </Grid>

                                <!-- Simple badge row -->
                                <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>
                                <StackLayout Orientation="Horizontal" Padding="16,10" Spacing="8">
                                    <Label Text="📋" FontSize="13"/>
                                    <Label x:Name="summaryLabel"
                                           TextColor="#004225"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           VerticalTextAlignment="Center"/>
                                </StackLayout>
                            </StackLayout>
                        </yummy:PancakeView>

                        <!-- Empty State -->
                        <StackLayout x:Name="emptyStateView" 
                                     IsVisible="False"
                                     Padding="40,60"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                            <Label Text="📭" 
                                   FontSize="60" 
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="No Transactions Found" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="#666666"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,15,0,5"/>
                            <Label Text="Try adjusting your date range" 
                                   FontSize="14" 
                                   TextColor="#999999"
                                   HorizontalTextAlignment="Center"/>
                        </StackLayout>

                        <!-- Transaction List -->
                        <ListView x:Name="listView" 
                                  SeparatorVisibility="None"
                                  HasUnevenRows="True" 
                                  ItemsSource="{Binding HD}"
                                  Margin="20,0,20,20"
                                  VerticalOptions="FillAndExpand"
                                  CachingStrategy="RecycleElement">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <yummy:PancakeView 
                                            HasShadow="True" 
                                            BackgroundColor="White" 
                                            CornerRadius="15"
                                            Margin="0,5,0,10"
                                            Padding="0"
                                            Elevation="4"
                                            BorderColor="#E0E0E0"
                                            BorderThickness="1">

                                            <Grid RowDefinitions="Auto,Auto">
                                                <!-- Header Bar -->
                                                <Grid Grid.Row="0" 
                                                      BackgroundColor="#004225" 
                                                      Padding="15,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                                        <Image Source="yobe" Aspect="AspectFit" HeightRequest="50"/>
                                                        <Label Text="{Binding serviceName}" 
                                                               TextColor="White" 
                                                               FontSize="15" 
                                                               FontAttributes="Bold"
                                                               VerticalTextAlignment="Center"/>
                                                    </StackLayout>

                                                    <Label Grid.Column="1" 
                                                           Text="{Binding amount, StringFormat='₦{0:N2}'}" 
                                                           TextColor="#FFD700" 
                                                           FontSize="16"
                                                           FontAttributes="Bold"
                                                           VerticalTextAlignment="Center"/>
                                                </Grid>

                                                <!-- Transaction Details -->
                                                <StackLayout Grid.Row="1" 
                                                             Padding="15,15,15,15" 
                                                             Spacing="10">

                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Label Text="Transaction ID:" 
                                                               FontSize="12" 
                                                               TextColor="#666666"
                                                               VerticalTextAlignment="Center"/>
                                                        <Label Grid.Column="1" 
                                                               Text="{Binding transactionId}" 
                                                               TextColor="#004225" 
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               LineBreakMode="TailTruncation"
                                                               VerticalTextAlignment="Center"/>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Label Text="Business:" 
                                                               FontSize="12" 
                                                               TextColor="#666666"
                                                               VerticalTextAlignment="Center"/>
                                                        <Label Grid.Column="1" 
                                                               Text="{Binding businessName}" 
                                                               TextColor="#333333" 
                                                               FontSize="12"
                                                               LineBreakMode="WordWrap"
                                                               VerticalTextAlignment="Center"/>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Label Text="Payer ID:" 
                                                               FontSize="12" 
                                                               TextColor="#666666"
                                                               VerticalTextAlignment="Center"/>
                                                        <Label Grid.Column="1" 
                                                               Text="{Binding payerId}" 
                                                               TextColor="#333333" 
                                                               FontSize="12"
                                                               VerticalTextAlignment="Center"/>
                                                    </Grid>

                                                    <BoxView HeightRequest="1" 
                                                             BackgroundColor="#E0E0E0" 
                                                             Margin="0,5,0,5"/>

                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Label Text="🕐" 
                                                               FontSize="14"
                                                               VerticalTextAlignment="Center"/>
                                                        <Label Grid.Column="1" 
                                                               Text="{Binding dateRecorded, StringFormat='{0:MMMM d, yyyy h:mm tt}'}" 
                                                               TextColor="#666666" 
                                                               FontSize="11"
                                                               VerticalTextAlignment="Center"/>
                                                    </Grid>
                                                </StackLayout>
                                            </Grid>
                                        </yummy:PancakeView>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackLayout>
                </yummy:PancakeView>
            </StackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid x:Name="loadingOverlay" 
              IsVisible="False" 
              BackgroundColor="#80000000"
              InputTransparent="False">
            <yummy:PancakeView 
                BackgroundColor="White"
                CornerRadius="15"
                Padding="30,25"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                HasShadow="True"
                Elevation="10">
                <StackLayout Spacing="15" WidthRequest="200">
                    <ActivityIndicator IsRunning="True" 
                                       Color="#004225" 
                                       HeightRequest="40"
                                       WidthRequest="40"
                                       HorizontalOptions="Center"/>
                    <Label Text="Loading transactions..." 
                           TextColor="#004225" 
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold"/>
                </StackLayout>
            </yummy:PancakeView>
        </Grid>
    </Grid>
</ContentPage>
