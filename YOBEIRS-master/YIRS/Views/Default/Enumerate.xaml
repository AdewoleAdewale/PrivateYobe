<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:renderers1="clr-namespace:YIRS.Renderers" 
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="YIRS.Views.Default.Enumerate"  
             BackgroundColor="#004225"
             Padding="0,20,0,0"
             NavigationPage.HasNavigationBar="True">

    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <StackLayout>

            <StackLayout Margin="20,10,20,0" Spacing="20">
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="REGISTER BUSINESS"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="CenterAndExpand" />
            </StackLayout>

            <yummy:PancakeView
                Margin="10,20,10,10"
                Padding="30,20,30,20"
                BackgroundColor="WhiteSmoke"
                CornerRadius="20"
                VerticalOptions="FillAndExpand"
                HasShadow="True"
                Elevation="5">
                <StackLayout Spacing="15" Padding="10">

                    <!-- Header Note -->
                    <yummy:PancakeView
                        BackgroundColor="#FFF3CD"
                        BorderColor="#FFC107"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15,10">
                        <Label 
                            Text="⚠️ Fields marked with * are required. Please fill them before submission." 
                            TextColor="#856404"  
                            FontAttributes="Bold" 
                            FontSize="14" 
                            HorizontalTextAlignment="Center" />
                    </yummy:PancakeView>

                    <!-- Business Name -->
                    <StackLayout Spacing="8">
                        <Label
                            Margin="10,0,0,0"
                            FontSize="15"
                            FontAttributes="Bold"
                            Text="BUSINESS NAME *"
                            TextColor="#004225" />
                        <yummy:PancakeView
                            Padding="15,0,15,0"
                            BackgroundColor="White"
                            BorderThickness="2"
                            BorderColor="#E0E0E0"
                            CornerRadius="12"
                            Elevation="2"                            
                            HeightRequest="50">
                            <renderers1:BorderlessEntry
                                FontSize="14"
                                ClearButtonVisibility="WhileEditing"
                                Keyboard="Text"
                                IsEnabled="True"
                                Placeholder="Enter business name"
                                PlaceholderColor="#999"
                                TextColor="Black"
                                x:Name="BusinessName"/>
                        </yummy:PancakeView>
                        <Label x:Name="BusinessNameError" TextColor="Red" FontSize="12" IsVisible="False" Margin="10,0,0,0"/>
                    </StackLayout>

                    <!-- RC Number -->
                    <StackLayout Spacing="8">
                        <Label
                            Margin="10,0,0,0"
                            FontSize="15"
                            FontAttributes="Bold"
                            Text="RC NUMBER"
                            TextColor="#004225" />
                        <yummy:PancakeView
                            Padding="15,0,15,0"
                            BackgroundColor="White"
                            BorderThickness="2"
                            BorderColor="#E0E0E0"
                            CornerRadius="12"
                            Elevation="2"
                            HeightRequest="50">
                            <renderers1:BorderlessEntry
                                FontSize="14"
                                ClearButtonVisibility="WhileEditing"
                                IsPassword="False"
                                IsEnabled="True"
                                Placeholder="Enter RC number (optional)"
                                PlaceholderColor="#999"
                                TextColor="Black" 
                                x:Name="RegistrationNumber"/>
                        </yummy:PancakeView>
                    </StackLayout>

                    <!-- Category -->
                    <StackLayout Spacing="8">
                        <Label
                            Margin="10,0,0,0"
                            FontSize="15"
                            FontAttributes="Bold"
                            Text="BUSINESS CATEGORY *"
                            TextColor="#004225" />
                        <yummy:PancakeView
                            Padding="15,0,15,0"
                            BackgroundColor="White"
                            BorderThickness="2"
                            BorderColor="#E0E0E0"
                            CornerRadius="12"
                            Elevation="2"
                            HeightRequest="50">
                            <Picker x:Name="picker" Title="Select Business Category" FontSize="14" TitleColor="#999" TextColor="Black"/>
                        </yummy:PancakeView>
                        <Label x:Name="CategoryError" TextColor="Red" FontSize="12" IsVisible="False" Margin="10,0,0,0"/>
                    </StackLayout>

                    <!-- Description -->
                    <StackLayout Spacing="8">
                        <Label
                            Margin="10,0,0,0"
                            FontSize="15"
                            FontAttributes="Bold"
                            Text="BUSINESS DESCRIPTION *"
                            TextColor="#004225" />
                        <yummy:PancakeView
                            Padding="15,10,15,10"
                            BackgroundColor="White"
                            BorderThickness="2"
                            BorderColor="#E0E0E0"
                            CornerRadius="12"
                            Elevation="2"
                            HeightRequest="100">
                            <renderers1:Wide
                                FontSize="14"
                                Placeholder="Describe your business"
                                PlaceholderColor="#999"
                                HeightRequest="100"
                                IsEnabled="True"
                                TextColor="Black" 
                                x:Name="Description"/>
                        </yummy:PancakeView>
                        <Label x:Name="DescriptionError" TextColor="Red" FontSize="12" IsVisible="False" Margin="10,0,0,0"/>
                    </StackLayout>

                    <!-- Business Owner -->
                    <StackLayout Spacing="8">
                        <Label
                            Margin="10,0,0,0"
                            FontSize="15"
                            FontAttributes="Bold"
                            Text="BUSINESS OWNER *"
                            TextColor="#004225" />
                        <yummy:PancakeView
                            Padding="15,0,15,0"
                            BackgroundColor="White"
                            BorderThickness="2"
                            BorderColor="#E0E0E0"
                            CornerRadius="12"
                            Elevation="2"
                            HeightRequest="50">
                            <renderers1:BorderlessEntry
                                FontSize="14"
                                ClearButtonVisibility="WhileEditing"
                                IsPassword="False"
                                Placeholder="Enter owner's name"
                                PlaceholderColor="#999"
                                IsEnabled="True"
                                TextColor="Black" 
                                x:Name="BusinessOwner"/>
                        </yummy:PancakeView>
                        <Label x:Name="OwnerError" TextColor="Red" FontSize="12" IsVisible="False" Margin="10,0,0,0"/>
                    </StackLayout>

                    <!-- TIN -->
                    <StackLayout Spacing="8">
                        <Label
                            Margin="10,0,0,0"
                            FontSize="15"
                            Text="TIN"
                            FontAttributes="Bold"
                            TextColor="#004225" />
                        <yummy:PancakeView
                            Padding="15,0,15,0"
                            BackgroundColor="White"
                            BorderThickness="2"
                            BorderColor="#E0E0E0"
                            CornerRadius="12"
                            Elevation="2"
                            HeightRequest="50">
                            <renderers1:BorderlessEntry
                                FontSize="14"
                                ClearButtonVisibility="WhileEditing"
                                IsPassword="False"
                                Placeholder="Enter TIN (optional)"
                                PlaceholderColor="#999"
                                IsEnabled="True"
                                TextColor="Black" 
                                x:Name="TIN"/>
                        </yummy:PancakeView>
                    </StackLayout>

                    <!-- Owner Phone -->
                    <StackLayout Spacing="8">
                        <Label
                            Margin="10,0,0,0"
                            FontSize="15"
                            FontAttributes="Bold"
                            Text="OWNER PHONE *"
                            TextColor="#004225" />
                        <yummy:PancakeView
                            Padding="15,0,15,0"
                            BackgroundColor="White"
                            BorderThickness="2"
                            BorderColor="#E0E0E0"
                            CornerRadius="12"
                            Elevation="2"
                            HeightRequest="50">
                            <renderers1:BorderlessEntry
                                FontSize="14"
                                ClearButtonVisibility="WhileEditing"
                                IsPassword="False"
                                Placeholder="Enter 11-digit phone number"
                                PlaceholderColor="#999"
                                MaxLength="11"
                                Keyboard="Telephone"
                                IsEnabled="True"
                                TextColor="Black" 
                                x:Name="OwnerPhone"/>
                        </yummy:PancakeView>
                        <Label x:Name="PhoneError" TextColor="Red" FontSize="12" IsVisible="False" Margin="10,0,0,0"/>
                    </StackLayout>

                    <!-- Email -->
                    <StackLayout Spacing="8">
                        <Label
                            Margin="10,0,0,0"
                            FontSize="15"
                            FontAttributes="Bold"
                            Text="EMAIL ADDRESS"
                            TextColor="#004225" />
                        <yummy:PancakeView
                            Padding="15,0,15,0"
                            BackgroundColor="White"
                            BorderThickness="2"
                            BorderColor="#E0E0E0"
                            CornerRadius="12"
                            Elevation="2"
                            HeightRequest="50">
                            <renderers1:BorderlessEntry
                                FontSize="14"
                                ClearButtonVisibility="WhileEditing"
                                IsPassword="False"
                                Keyboard="Email"
                                Placeholder="Enter email (optional)"
                                PlaceholderColor="#999"
                                IsEnabled="True"
                                TextColor="Black" 
                                x:Name="EmailAddress"/>
                        </yummy:PancakeView>
                        <Label x:Name="EmailError" TextColor="Red" FontSize="12" IsVisible="False" Margin="10,0,0,0"/>
                    </StackLayout>

                    <!-- Business Address -->
                    <StackLayout Spacing="8">
                        <Label
                            Margin="10,0,0,0"
                            FontSize="15"
                            FontAttributes="Bold"
                            Text="BUSINESS ADDRESS *"
                            TextColor="#004225" />
                        <yummy:PancakeView
                            Padding="15,10,15,10"
                            BackgroundColor="White"
                            BorderThickness="2"
                            BorderColor="#E0E0E0"
                            CornerRadius="12"
                            Elevation="2"
                            HeightRequest="100">
                            <renderers1:Wide
                                FontSize="14"
                                Placeholder="Enter full business address (minimum 20 characters)"
                                PlaceholderColor="#999"
                                IsEnabled="True"
                                TextColor="Black" 
                                x:Name="BusinessAddress"/>
                        </yummy:PancakeView>
                        <Label x:Name="AddressError" TextColor="Red" FontSize="12" IsVisible="False" Margin="10,0,0,0"/>
                    </StackLayout>

                    <!-- LGA -->
                    <StackLayout Spacing="8">
                        <Label
                            Margin="10,0,0,0"
                            FontSize="15"
                            FontAttributes="Bold"
                            Text="LGA *"
                            TextColor="#004225" />
                        <yummy:PancakeView
                            Padding="15,0,15,0"
                            BackgroundColor="White"
                            BorderThickness="2"
                            BorderColor="#E0E0E0"
                            CornerRadius="12"
                            Elevation="2"
                            HeightRequest="50">
                            <Picker x:Name="picker2" Title="Select LGA" FontSize="14" TitleColor="#999" TextColor="Black">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Bade</x:String>
                                        <x:String>Bursari</x:String>
                                        <x:String>Damaturu</x:String>
                                        <x:String>Fika</x:String>
                                        <x:String>Fune</x:String>
                                        <x:String>Geidam</x:String>
                                        <x:String>Gujba</x:String>
                                        <x:String>Gulani</x:String>
                                        <x:String>Jakuso</x:String>
                                        <x:String>Karasuwa</x:String>
                                        <x:String>Machina</x:String>
                                        <x:String>Nangere</x:String>
                                        <x:String>Nguru</x:String>
                                        <x:String>Potiskum</x:String>
                                        <x:String>Tarmuwa</x:String>
                                        <x:String>Yunusari</x:String>
                                        <x:String>Yusufari</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </yummy:PancakeView>
                        <Label x:Name="LGAError" TextColor="Red" FontSize="12" IsVisible="False" Margin="10,0,0,0"/>
                    </StackLayout>

                    <!-- Location -->
                    <StackLayout Spacing="8" Margin="0,0,0,20">
                        <Label
                            Margin="10,0,0,0"
                            FontSize="15"
                            FontAttributes="Bold"
                            Text="LOCATION *"
                            TextColor="#004225" />
                        <yummy:PancakeView
                            Padding="15,0,15,0"
                            BackgroundColor="White"
                            BorderThickness="2"
                            BorderColor="#E0E0E0"
                            CornerRadius="12"
                            Elevation="2"
                            HeightRequest="50">
                            <renderers1:BorderlessEntry
                                FontSize="14"
                                ClearButtonVisibility="WhileEditing"
                                Placeholder="Enter specific location"
                                PlaceholderColor="#999"
                                IsPassword="False"
                                IsEnabled="True"
                                TextColor="Black" 
                                x:Name="Location"/>
                        </yummy:PancakeView>
                        <Label x:Name="LocationError" TextColor="Red" FontSize="12" IsVisible="False" Margin="10,0,0,0"/>
                    </StackLayout>

                    <!-- Submit Button -->
                    <yummy:PancakeView
                        BackgroundColor="#004225"
                        BorderThickness="0"
                        CornerRadius="12"
                        HasShadow="True"
                        Elevation="5"
                        HeightRequest="60"
                        HorizontalOptions="FillAndExpand"
                        Margin="0,10,0,0">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            Text="REGISTER BUSINESS"
                            TextColor="White"
                            VerticalOptions="CenterAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>
                </StackLayout>
            </yummy:PancakeView>
        </StackLayout>
    </ScrollView>
</ContentPage>